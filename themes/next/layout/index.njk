{% extends '_layout.njk' %}
{% import '_macro/sidebar.njk' as sidebar_template with context %}

{% block title %}{{ title }}{% if theme.index_with_subtitle and subtitle %} - {{ subtitle }}{% endif %}{% endblock %}

{% block class %}index posts-expand signal-index{% endblock %}

{% block content %}
  {#- SIGNAL home sections come from scripts/signal-home.js. -#}
  {%- if page.current === 1 %}
    {{ signal_home_hero() }}
  {%- endif %}

  <section class="signal-section signal-codex" id="codex" aria-labelledby="codex-title">
    <div class="signal-inner">
      <div class="signal-head">
        <h2 class="signal-h2" id="codex-title">札记<small>entries, newest first</small></h2>
        {{ signal_codex_filters() }}
      </div>
      {{ signal_codex(page.posts) }}
      <div class="signal-codex-foot">
        {%- include '_partials/pagination.njk' -%}
        {%- if site.posts.length %}
        <a class="signal-more" href="{{ url_for(config.archive_dir + '/') }}">全部归档 →</a>
        {%- endif %}
      </div>
    </div>
  </section>

  {%- if page.current === 1 %}
    {{ signal_home_outro() }}
  {%- endif %}
{% endblock %}

{% block sidebar %}
  {{ sidebar_template.render(false) }}
{% endblock %}
