// SIGNAL home page: hero, 疆域, 札记, 远征, 年鉴 (scripts/signal-home.js).
@css {
  .signal-inner {
    max-width: 1240px;
    margin: 0 auto;
  }

  .signal-section {
    padding-right: var(--gutr);
    padding-left: var(--gut);
  }

  .signal-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px 24px;
    margin-bottom: 36px;
  }

  .signal-h2 {
    margin: 0;
    color: var(--fg);
    font: 900 clamp(46px, 7vw, 100px)/1.08 var(--f-cn-display);
    letter-spacing: .06em;
  }

  .signal-h2 small {
    display: block;
    margin-top: 12px;
    color: var(--mute);
    font: italic 500 clamp(20px, 2.4vw, 30px)/1.3 var(--f-poem);
    letter-spacing: 0;
  }

  .signal-eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--mute);
    font: 12px var(--f-mono);
    letter-spacing: .22em;
    text-transform: uppercase;
  }

  .signal-eyebrow::before {
    content: "";
    width: 28px;
    height: 1px;
    background: var(--cyan);
  }

  .signal-count {
    color: var(--mute);
    font: 12px var(--f-mono);
    letter-spacing: .1em;
  }

  .signal-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .signal-chip {
    padding: 6px 12px;
    border: 1px solid var(--line-2);
    border-radius: 2px;
    background: none;
    color: var(--mute);
    font: 12px var(--f-mono);
    letter-spacing: .06em;
    cursor: pointer;
  }

  .signal-chip:hover {
    color: var(--fg);
  }

  .signal-chip[aria-pressed="true"] {
    border-color: var(--fg);
    background: var(--fg);
    color: var(--void);
  }

  .signal-more {
    border-bottom: 1px solid var(--line-2);
    color: var(--mute);
    font: 12px var(--f-mono);
    letter-spacing: .08em;
  }

  .signal-more:hover {
    border-bottom-color: var(--cyan);
    color: var(--fg);
  }

  .signal-empty {
    margin: 0;
    padding: 32px 0;
    color: var(--mute);
    font-size: 15px;
  }

  /* ───── Hero ───── */
  .signal-hero {
    position: relative;
    height: 150vh;
  }

  .signal-hero-stage {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
  }

  .signal-hero-canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    /* Let the scattered dust thin out instead of ending on a hard edge. */
    -webkit-mask-image: linear-gradient(to bottom, #000 72%, transparent);
    mask-image: linear-gradient(to bottom, #000 72%, transparent);
  }

  .signal-hero-copy {
    position: absolute;
    right: 0;
    bottom: calc(env(safe-area-inset-bottom, 0px) + 10vh);
    left: 0;
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 var(--gutr) 0 var(--gut);
    pointer-events: none;
  }

  .signal-hero-title {
    margin: 0;
    color: var(--fg);
    font: italic 500 clamp(40px, 6.4vw, 92px)/1.02 var(--f-poem);
    letter-spacing: -.01em;
  }

  .signal-hero-title span {
    padding-right: .08em;
    background: linear-gradient(90deg, var(--cyan), var(--violet));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .signal-scroll-hint {
    position: absolute;
    right: calc(var(--gutr) + 10px);
    bottom: calc(env(safe-area-inset-bottom, 0px) + 10vh);
    width: 1px;
    height: 70px;
    overflow: hidden;
    background: var(--line-2);
  }

  .signal-scroll-hint::after {
    content: "";
    position: absolute;
    top: -30px;
    left: 0;
    width: 1px;
    height: 30px;
    background: var(--cyan);
    animation: signal-drip 2s infinite;
  }

  @keyframes signal-drip {
    to {
      top: 70px;
    }
  }

  /* ───── 疆域: layout follows the number of categories ───── */
  .signal-realms {
    position: relative;
    padding-top: 120px;
    padding-bottom: 40px;
  }

  .signal-realm-grid {
    max-width: 1240px;
    margin: 0 auto;
  }

  .signal-realm {
    position: relative;
    display: grid;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--ink);
  }

  .signal-realm-emblem {
    position: relative;
    min-height: 0;
    border-right: 1px solid var(--line);
    background: radial-gradient(120% 90% at 30% 50%, rgba(124, 236, 255, .06), transparent 60%);
  }

  .signal-realm-emblem canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .signal-realm-info {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 14px;
    padding: 28px 30px;
  }

  .signal-realm-index {
    color: var(--cyan);
    font: 12px var(--f-mono);
    letter-spacing: .14em;
  }

  .signal-realm h3 {
    margin: 0;
    color: var(--fg);
    font: 900 clamp(72px, 10vw, 150px)/.82 var(--f-display);
    letter-spacing: .02em;
  }

  .signal-realm-epithet {
    margin: 0;
    color: var(--fg);
    font: italic 500 26px/1.2 var(--f-poem);
  }

  .signal-realm-desc {
    max-width: 40ch;
    margin: 0;
    color: var(--mute);
    font: italic 500 19px/1.45 var(--f-poem);
  }

  .signal-realm dl {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 6px 18px;
    margin: 6px 0 0;
    font: 12px var(--f-mono);
  }

  .signal-realm dt {
    color: var(--mute);
    letter-spacing: .1em;
  }

  .signal-realm dd {
    margin: 0;
    overflow: hidden;
    color: var(--fg);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .signal-realm-enter {
    align-self: flex-start;
    margin-top: auto;
    padding: 9px 16px;
    border: 1px solid var(--line-2);
    color: var(--fg);
    font: 12px var(--f-mono);
    letter-spacing: .1em;
    transition: border-color .2s ease, background .2s ease;
  }

  .signal-realm-enter:hover {
    border-color: var(--cyan);
    background: rgba(124, 236, 255, .06);
    color: var(--fg);
  }

  .signal-realm-enter.is-empty {
    color: var(--mute);
  }

  .signal-realms[data-mode="solo"] .signal-realm-grid {
    display: grid;
  }

  .signal-realms[data-mode="solo"] .signal-realm {
    grid-template-columns: 1.25fr 1fr;
    height: min(560px, 72vh);
  }

  .signal-realms[data-mode="pair"] .signal-realm-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  .signal-realms[data-mode="pair"] .signal-realm,
  .signal-realms[data-mode="track"] .signal-realm {
    grid-template-rows: 240px auto;
  }

  .signal-realms[data-mode="pair"] .signal-realm-emblem,
  .signal-realms[data-mode="track"] .signal-realm-emblem {
    border-right: 0;
    border-bottom: 1px solid var(--line);
  }

  @media (min-width: 821px) {
    .signal-realms[data-mode="track"] {
      padding: 0;
    }

    .signal-realms[data-mode="track"] .signal-realms-stage {
      position: sticky;
      top: 0;
      display: flex;
      height: 100vh;
      flex-direction: column;
      justify-content: center;
      gap: 28px;
      overflow: hidden;
    }

    .signal-realms[data-mode="track"] .signal-head {
      width: min(1240px, calc(100% - var(--gut) - var(--gutr)));
      box-sizing: border-box;
      margin: 0 auto;
      padding: 0;
    }

    .signal-realms[data-mode="track"] .signal-realm-grid {
      display: flex;
      max-width: none;
      gap: 24px;
      margin: 0;
      padding-left: max(var(--gut), calc((100% - 1240px) / 2));
      will-change: transform;
    }

    .signal-realms[data-mode="track"] .signal-realm {
      flex: 0 0 min(520px, 78vw);
      height: min(460px, 60vh);
      grid-template-rows: 200px auto;
    }

    .signal-realms[data-mode="track"] .signal-realm h3 {
      font-size: clamp(56px, 6vw, 88px);
    }
  }

  @media (max-width: 820px) {
    .signal-realms[data-mode] .signal-realm {
      height: auto;
      grid-template-columns: 1fr;
      grid-template-rows: 240px auto;
    }

    .signal-realms[data-mode] .signal-realm-emblem {
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }

    .signal-realms[data-mode] .signal-realm-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .signal-realm-info {
      padding: 24px 20px;
    }
  }

  /* ───── 札记 ───── */
  .signal-codex {
    padding-top: 120px;
    padding-bottom: 80px;
  }

  .signal-index > .signal-codex:first-of-type {
    padding-top: calc(var(--header-h) + var(--header-top) + 80px);
  }

  .signal-seglist {
    border-top: 1px solid var(--line);
  }

  .signal-seg {
    position: relative;
    display: grid;
    grid-template-columns: 120px 96px minmax(0, 1fr) 170px 64px;
    align-items: baseline;
    gap: 20px;
    padding: 26px 8px;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }

  .signal-seg::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(124, 236, 255, .07), transparent 70%);
    opacity: 0;
    transition: opacity .4s ease;
  }

  .signal-seg:hover::before,
  .signal-seg:focus-within::before {
    opacity: 1;
  }

  .signal-seg > * {
    position: relative;
  }

  .signal-seg-addr {
    color: var(--cyan);
    font: 12px var(--f-mono);
  }

  .signal-seg time {
    color: var(--mute);
    font: 12px var(--f-mono);
    font-variant-numeric: tabular-nums;
  }

  .signal-seg h3 {
    margin: 0;
    font: 700 clamp(21px, 2.3vw, 28px)/1.35 var(--f-cn-display);
  }

  .signal-seg-link {
    position: static;
    border: 0;
    color: var(--fg);
    transition: color .3s ease;
  }

  .signal-seg-link::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .signal-seg:hover .signal-seg-link {
    color: #fff;
  }

  .signal-seg-link:focus-visible {
    outline: 0;
  }

  .signal-seg-link:focus-visible::after {
    outline: 2px solid var(--cyan);
    outline-offset: -2px;
  }

  .signal-seg p {
    max-width: 58ch;
    margin: 6px 0 0;
    color: var(--mute);
    font-size: 14.5px;
  }

  .signal-seg-tags {
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 8px;
    font: 12px var(--f-mono);
  }

  .signal-seg-tags a {
    border: 0;
    color: var(--violet);
  }

  .signal-seg-tags a:hover {
    color: #fff;
  }

  .signal-seg-tags .signal-seg-realm {
    padding: 0 6px;
    border: 1px solid var(--line-2);
    color: var(--fg);
  }

  .signal-seg-size {
    color: var(--mute);
    font: 12px var(--f-mono);
    text-align: right;
  }

  .signal-codex-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 28px;
  }

  .signal-codex-foot .pagination {
    margin: 0;
  }

  @media (max-width: 860px) {
    .signal-seg {
      grid-template-columns: 1fr auto;
      gap: 6px 14px;
      padding: 22px 4px;
    }

    .signal-seg-main {
      grid-column: 1 / -1;
    }
  }

  /* ───── 远征: route graph (also on /learning-paths/) ───── */
  .signal-odyssey {
    padding-top: 100px;
    padding-bottom: 100px;
  }

  .route-graph {
    overflow-x: auto;
    border: 1px solid var(--line);
    background:
      linear-gradient(var(--line) 1px, transparent 1px) 0 0 / 40px 40px,
      linear-gradient(90deg, var(--line) 1px, transparent 1px) 0 0 / 40px 40px,
      var(--ink);
  }

  .route-graph:empty {
    display: none;
  }

  .route-svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .route-node rect {
    fill: var(--ink-2);
    stroke: var(--line-2);
    stroke-width: 1;
    transition: stroke .2s ease, fill .2s ease;
  }

  .route-node.is-published:hover rect,
  .route-node.is-published:focus rect {
    fill: #151b2e;
    stroke: var(--cyan);
  }

  .route-node.is-published rect.route-bar {
    fill: var(--cyan);
    stroke: none;
  }

  .route-node.is-planned rect.route-bar {
    fill: var(--heat);
    stroke: none;
  }

  .route-node text {
    fill: var(--fg);
    font: 500 16px var(--f-body);
  }

  .route-svg.is-narrow .route-node text {
    font-size: 14px;
  }

  .route-node.is-planned text {
    fill: var(--mute);
  }

  .route-node text.route-addr,
  .route-svg.is-narrow .route-node text.route-addr {
    fill: var(--mute);
    font: 11px var(--f-mono);
  }

  .route-edge {
    fill: none;
    stroke: var(--violet);
    stroke-width: 1.5;
    stroke-dasharray: var(--len);
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 1.1s cubic-bezier(.6, 0, .2, 1);
  }

  .route-svg.is-hidden .route-edge {
    stroke-dashoffset: var(--len);
  }

  .route-label {
    fill: var(--mute);
    font: 11px var(--f-mono);
  }

  .route-svg marker path {
    fill: var(--violet);
  }

  .signal-legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px;
    margin-top: 14px;
    color: var(--mute);
    font: 12px var(--f-mono);
  }

  .signal-legend i {
    display: inline-block;
    width: 10px;
    height: 10px;
    margin-right: 6px;
    vertical-align: -1px;
  }

  .signal-legend .is-published {
    background: var(--cyan);
  }

  .signal-legend .is-planned {
    background: var(--heat);
  }

  .signal-legend .signal-more {
    margin-left: auto;
  }

  /* ───── 年鉴 ───── */
  .signal-almanac {
    padding-top: 100px;
    padding-bottom: 140px;
  }

  .signal-registers {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: 36px;
    border: 1px solid var(--line);
  }

  .signal-register {
    display: flex;
    min-width: 0;
    flex-direction: column;
    padding: 22px 20px;
    border-right: 1px solid var(--line);
  }

  .signal-register:last-child {
    border-right: 0;
  }

  .signal-register-name {
    color: var(--cyan);
    font: 12px var(--f-mono);
    letter-spacing: .1em;
  }

  .signal-register-value {
    margin: 10px 0 6px;
    overflow: hidden;
    color: var(--fg);
    font: 900 clamp(40px, 6vw, 84px)/1 var(--f-display);
    font-variant-numeric: tabular-nums;
    text-overflow: ellipsis;
  }

  .signal-register-label {
    color: var(--mute);
    font: italic 500 20px var(--f-poem);
  }

  .signal-register-hex {
    margin-top: 4px;
    color: var(--mute);
    font: 11px var(--f-mono);
  }

  .signal-spectrum {
    margin-top: 32px;
  }

  .signal-spectrum-bar {
    display: flex;
    height: 44px;
    margin-top: 14px;
    border: 1px solid var(--line);
  }

  .signal-spectrum-bar a {
    border: 0;
    border-right: 1px solid var(--void);
    background: var(--c);
    transition: filter .2s ease;
  }

  .signal-spectrum-bar a:hover {
    filter: brightness(1.3);
  }

  .signal-spectrum-keys {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    margin-top: 12px;
    font: 12px var(--f-mono);
  }

  .signal-spectrum-keys a {
    border: 0;
    color: var(--mute);
  }

  .signal-spectrum-keys a:hover {
    color: var(--fg);
  }

  .signal-spectrum-keys i {
    display: inline-block;
    width: 10px;
    height: 10px;
    margin-right: 6px;
    vertical-align: -1px;
    background: var(--c);
  }

  @media (max-width: 760px) {
    .signal-registers {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .signal-register:nth-child(2) {
      border-right: 0;
    }

    .signal-register:nth-child(-n+2) {
      border-bottom: 1px solid var(--line);
    }
  }
}
