// The home page: the hero, then the newest 札记 (scripts/signal-home.js).
// The route graph drawn on 远征 is styled here too.
@css {
  .signal-inner {
    max-width: var(--page-w);
    margin: 0 auto;
  }

  .signal-section {
    padding-right: var(--gutr);
    padding-left: var(--gut);
  }

  .signal-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px 24px;
    margin-bottom: 36px;
  }

  .signal-h2 {
    margin: 0;
    color: var(--fg);
    font: 900 clamp(46px, 7vw, 100px)/1.08 var(--f-cn-display);
    letter-spacing: .06em;
  }

  .signal-h2 small {
    display: block;
    margin-top: 12px;
    color: var(--mute);
    font: italic 500 clamp(20px, 2.4vw, 30px)/1.3 var(--f-poem);
    letter-spacing: 0;
  }

  .signal-count {
    color: var(--mute);
    font: 12px var(--f-mono);
    letter-spacing: .1em;
  }

  .signal-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .signal-chip {
    padding: 6px 12px;
    border: 1px solid var(--line-2);
    border-radius: 2px;
    background: var(--void);
    color: var(--mute);
    font: 12px var(--f-mono);
    letter-spacing: .06em;
    cursor: var(--cursor-pointer, pointer);
  }

  .signal-chip:hover {
    color: var(--fg);
  }

  .signal-chip[aria-pressed="true"] {
    border-color: var(--fg);
    background: var(--fg);
    color: var(--void);
  }

  .signal-more {
    border-bottom: 1px solid var(--line-2);
    color: var(--mute);
    font: 12px var(--f-mono);
    letter-spacing: .08em;
  }

  .signal-more:hover {
    border-bottom-color: var(--cyan);
    color: var(--fg);
  }

  .signal-empty {
    margin: 0;
    padding: 32px 0;
    color: var(--mute);
    font-size: 15px;
  }

  /* Titles end lines between words (scripts/signal-typeset.js). */
  .signal-seg h3,
  .signal-hero-latest-title {
    word-break: keep-all;
    overflow-wrap: anywhere;
  }

  /* ───── Hero ───── */
  /* One screen, never pinned: the wordmark scatters into dust as it scrolls
     away, so the page keeps its own scrolling rhythm. */
  .signal-hero {
    position: relative;
    height: 100vh;
    height: 100svh;
  }

  .signal-hero-stage {
    position: relative;
    height: 100%;
    overflow: hidden;
  }

  .signal-hero-canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    /* Let the scattered dust thin out instead of ending on a hard edge. */
    -webkit-mask-image: linear-gradient(to bottom, #000 72%, transparent);
    mask-image: linear-gradient(to bottom, #000 72%, transparent);
  }

  /* Slogan on the left, the newest entry across from it on the right;
     stacked on phones. */
  .signal-hero-copy {
    position: absolute;
    right: 0;
    bottom: calc(env(safe-area-inset-bottom, 0px) + 10vh);
    left: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px 48px;
    max-width: var(--page-w);
    margin: 0 auto;
    padding: 0 var(--gutr) 0 var(--gut);
    pointer-events: none;
  }

  .signal-hero-title {
    margin: 0;
    color: var(--fg);
    font: italic 500 clamp(40px, 6.4vw, 92px)/1.02 var(--f-poem);
    letter-spacing: -.01em;
  }

  /* The newest entry, one tap from the first screen. */
  .signal-hero-latest {
    display: inline-flex;
    max-width: 360px;
    flex-direction: column;
    gap: 6px;
    margin-bottom: .6em;
    border: 0;
    color: var(--fg);
    pointer-events: auto;
  }

  /* Keep clear of the scroll hint once the copy reaches the screen edge. */
  @media (max-width: 1340px) {
    .signal-hero-latest {
      margin-right: 32px;
    }
  }

  @media (max-width: 760px) {
    .signal-hero-latest {
      margin-bottom: 0;
    }
  }

  .signal-hero-latest-meta {
    color: var(--mute);
    font: 12px var(--f-mono);
    letter-spacing: .12em;
  }

  .signal-hero-latest-title {
    border-bottom: 1px solid var(--line-2);
    font: 500 17px/1.5 var(--f-body);
    transition: border-color var(--t-fast) var(--ease);
  }

  .signal-hero-latest:hover .signal-hero-latest-title {
    border-bottom-color: var(--cyan);
  }

  .signal-hero-title span {
    padding-right: .08em;
    background: linear-gradient(90deg, var(--cyan), var(--violet));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .signal-scroll-hint {
    position: absolute;
    right: calc(var(--gutr) + 10px);
    bottom: calc(env(safe-area-inset-bottom, 0px) + 10vh);
    width: 1px;
    height: 70px;
    overflow: hidden;
    background: var(--line-2);
  }

  .signal-scroll-hint::after {
    content: "";
    position: absolute;
    top: -30px;
    left: 0;
    width: 1px;
    height: 30px;
    background: var(--cyan);
    animation: signal-drip 2s infinite;
  }

  @keyframes signal-drip {
    to {
      top: 70px;
    }
  }

  /* ───── 札记 ───── */
  .signal-codex {
    padding-top: 120px;
    padding-bottom: 80px;
  }

  .signal-index > .signal-codex:first-of-type {
    padding-top: calc(var(--header-h) + var(--header-top) + 80px);
  }

  .signal-seglist {
    position: relative;
  }

  .signal-seglist::before {
    content: "";
    display: block;
    height: 1px;
    background: var(--signal-line);
  }

  .signal-seg {
    position: relative;
    display: grid;
    grid-template-columns: 104px minmax(0, 1fr) 120px;
    align-items: baseline;
    gap: 20px;
    padding: 26px 8px;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }

  .signal-seg::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(124, 236, 255, .07), transparent 70%);
    opacity: 0;
    transition: opacity .4s ease;
  }

  .signal-seg:hover::before,
  .signal-seg:focus-within::before {
    opacity: 1;
  }

  .signal-seg > * {
    position: relative;
  }

  .signal-seg time {
    color: var(--mute);
    font: 12px var(--f-mono);
    font-variant-numeric: tabular-nums;
  }

  .signal-seg h3 {
    margin: 0;
    font: 700 clamp(21px, 2.3vw, 28px)/1.35 var(--f-cn-display);
  }

  .signal-seg-link {
    position: static;
    border: 0;
    color: var(--fg);
    transition: color var(--t-fast) var(--ease);
  }

  .signal-seg-link::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .signal-seg:hover .signal-seg-link {
    color: #fff;
  }

  .signal-seg-link:focus-visible {
    outline: 0;
  }

  .signal-seg-link:focus-visible::after {
    outline: 2px solid var(--cyan);
    outline-offset: -2px;
  }

  .signal-seg p {
    max-width: 58ch;
    margin: 6px 0 0;
    color: var(--mute);
    font-size: 14.5px;
  }

  .signal-seg-tags,
  .signal-seg-meta {
    position: relative;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    font: 12px var(--f-mono);
  }

  .signal-seg-tags {
    margin-top: 10px;
  }

  .signal-seg-meta {
    justify-content: flex-end;
    align-items: baseline;
    color: var(--mute);
  }

  .signal-seg-tags a,
  .signal-seg-meta a {
    border: 0;
    color: var(--mute);
    transition: color var(--t-fast) var(--ease);
  }

  .signal-seg-tags a:hover,
  .signal-seg-meta a:hover {
    color: var(--cyan);
  }

  .signal-seg-meta .signal-seg-realm {
    color: var(--text);
  }

  .signal-seg-meta .signal-seg-realm::after {
    content: "·";
    margin-left: 12px;
    color: var(--mute);
  }

  .signal-codex-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 16px;
    margin-top: 20px;
  }

  .signal-codex-foot .pagination {
    margin-right: auto;
  }

  .signal-codex-foot .pagination {
    margin: 0;
  }

  @media (max-width: 860px) {
    .signal-seg {
      grid-template-columns: 1fr auto;
      gap: 6px 14px;
      padding: 22px 4px;
    }

    .signal-seg-main {
      grid-column: 1 / -1;
    }

    .signal-seg-meta {
      grid-row: 1;
      grid-column: 2;
    }
  }

  /* ───── Scroll reveals ─────
     Tied to scrolling itself (scroll-driven animations), never pinned, and
     only where the browser supports them; elsewhere everything is simply
     there. 札记 rows come in like a disassembly listing being printed,
     left to right; headings rise. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .signal-seg {
        animation: signal-print linear both;
        animation-timeline: view();
        animation-range: entry 10% entry 90%;
      }

      .signal-h2{
        animation: signal-rise linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 70%;
      }

      @keyframes signal-print {
        from {
          opacity: .2;
          clip-path: inset(-20px 100% -20px -40px);
        }
        to {
          opacity: 1;
          clip-path: inset(-20px -20px -20px -40px);
        }
      }

      @keyframes signal-rise {
        from {
          opacity: 0;
          transform: translateY(36px);
        }
        to {
          opacity: 1;
          transform: none;
        }
      }

    }
  }
}
