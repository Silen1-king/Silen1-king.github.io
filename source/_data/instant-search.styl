// Seek: the Ctrl+K search palette (source/js/instant-search.js), styled as
// a gdb prompt. The trigger button lives in signal-base.styl with the header.
@css {
  .global-search-modal {
    position: fixed;
    inset: 0;
    z-index: 2147483647;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 14vh var(--gutr) 24px var(--gut);
    opacity: 0;
    transition: opacity .18s ease;
  }

  .global-search-modal.is-open {
    opacity: 1;
  }

  .global-search-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(5, 6, 11, .75);
  }

  .global-search-panel {
    position: relative;
    display: flex;
    width: min(680px, 100%);
    max-height: min(72vh, 640px);
    overflow: hidden;
    flex-direction: column;
    border: 1px solid var(--line-2);
    background: var(--ink);
    box-shadow: 0 30px 120px rgba(0, 0, 0, .6);
    transform: translateY(-10px) scale(.98);
    transition: transform .25s cubic-bezier(.2, .8, .2, 1);
  }

  .global-search-modal.is-open .global-search-panel {
    transform: none;
  }

  .global-search-header {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 12px 12px 18px;
    border-bottom: 1px solid var(--line);
  }

  .global-search-header > i {
    display: none;
  }

  .global-search-label {
    color: var(--cyan);
    font: 14px var(--f-mono);
    white-space: nowrap;
  }

  .global-search-input {
    min-width: 0;
    flex: 1;
    padding: 6px 0;
    border: 0;
    background: none;
    color: var(--fg);
    font: 15px var(--f-mono);
    outline: none;
  }

  .global-search-input::placeholder {
    color: var(--mute);
  }

  .global-search-input::-webkit-search-cancel-button {
    display: none;
  }

  .global-search-close {
    width: 36px;
    height: 36px;
    padding: 0;
    border: 1px solid var(--line-2);
    border-radius: 2px;
    background: none;
    color: var(--mute);
    font-size: 1.2em;
    line-height: 1;
    cursor: pointer;
  }

  .global-search-close:hover {
    border-color: var(--cyan);
    color: var(--fg);
  }

  .global-search-status {
    padding: 8px 18px;
    border-bottom: 1px solid var(--line);
    color: var(--mute);
    font: 11px var(--f-mono);
    letter-spacing: .06em;
  }

  .global-search-results {
    min-height: 120px;
    margin: 0;
    padding: 6px 0;
    overflow-y: auto;
    list-style: none;
  }

  .global-search-result {
    margin: 0;
  }

  .global-search-result.is-active,
  .global-search-result:hover {
    background: rgba(124, 236, 255, .08);
    box-shadow: inset 2px 0 var(--cyan);
  }

  .global-search-result-link {
    position: relative;
    display: block;
    padding: 12px 40px 12px 18px;
    border: 0 !important;
    color: inherit !important;
  }

  .global-search-result h3 {
    margin: 0 0 6px;
    color: var(--fg);
    font: 500 16px/1.45 var(--f-body);
  }

  .global-search-result p {
    display: -webkit-box;
    margin: 6px 0 0;
    overflow: hidden;
    color: var(--mute);
    font-size: 13px;
    line-height: 1.65;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .global-search-result > a > i {
    position: absolute;
    top: 16px;
    right: 16px;
    color: var(--mute);
  }

  .global-search-result.is-active > a > i,
  .global-search-result:hover > a > i {
    color: var(--cyan);
  }

  .global-search-result-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    font: 11px var(--f-mono);
  }

  .global-search-result-meta span {
    color: var(--violet);
  }

  .global-search-result-meta small {
    margin-right: 4px;
    color: var(--mute);
  }

  .global-search-result mark {
    padding: 0 1px;
    background: rgba(124, 236, 255, .22);
    color: var(--cyan);
  }

  .global-search-empty {
    display: grid;
    min-height: 120px;
    place-content: center;
    color: var(--mute);
    font-size: 14px;
    text-align: center;
  }

  .global-search-empty i {
    margin-bottom: 8px;
    font-size: 1.3em;
  }

  .global-search-empty p {
    margin: 0;
  }

  .global-search-footer {
    display: flex;
    gap: 16px;
    padding: 10px 18px;
    border-top: 1px solid var(--line);
    color: var(--mute);
    font: 11px var(--f-mono);
  }

  .global-search-footer span {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .global-search-footer kbd {
    padding: 1px 5px;
    border: 1px solid var(--line-2);
    border-radius: 2px;
    background: none;
    color: var(--mute);
    font: 11px var(--f-mono);
    box-shadow: none;
  }

  body.global-search-open {
    overflow: hidden;
  }

  @media (max-width: 767px) {
    .global-search-modal {
      padding: calc(10px + env(safe-area-inset-top, 0px)) calc(10px + env(safe-area-inset-right, 0px)) calc(10px + env(safe-area-inset-bottom, 0px)) calc(10px + env(safe-area-inset-left, 0px));
    }

    .global-search-panel {
      max-height: calc(100dvh - 20px);
    }

    .global-search-input {
      font-size: 16px;
    }

    .global-search-footer {
      display: none;
    }
  }
}
