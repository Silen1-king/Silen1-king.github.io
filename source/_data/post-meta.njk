{#- Added to NexT's post meta line: reading time, views and the post's tags, so a
    reader sees what the post covers before scrolling. -#}
{%- if post and not is_index %}
  <span class="post-meta-item post-meta-reading">{{ signal_reading_minutes(post) }} min</span>
  <span class="post-meta-item post-meta-views"><span id="vercount_value_page_pv">—</span> views</span>
  {%- if post.tags and post.tags.length %}
    <span class="post-meta-item post-meta-tags">
      {%- for tag in post.tags.toArray() %}
        <a href="{{ url_for(tag.path) }}" rel="tag">#{{ tag.name }}</a>
      {%- endfor %}
    </span>
  {%- endif %}
{%- endif %}
