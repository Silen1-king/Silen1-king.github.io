// 疆域 (/categories/): one quiet row per category
// (scripts/signal-channels.js). 漫游 and 友链 are in signal-pages.styl.
@css {
  .realm-map-list {
    margin: 8px 0 0;
    border-top: 1px solid var(--line);
    padding: 0;
    list-style: none;
  }

  .realm-map-list li {
    margin: 0;
    border-bottom: 1px solid var(--line);
  }

  .post-body .realm-map-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 24px;
    align-items: baseline;
    padding: 26px 4px;
    border: 0;
    color: var(--text);
  }

  .realm-map-body {
    display: grid;
    gap: 4px;
  }

  .realm-map-name {
    color: var(--fg);
    font: 700 28px/1.2 var(--f-cn-display);
    transition: color var(--t-fast) var(--ease);
  }

  .realm-map-row:hover .realm-map-name {
    color: var(--cyan);
  }

  .realm-map-epithet {
    color: var(--mute);
    font: italic 400 19px/1.3 var(--f-poem);
  }

  .realm-map-desc {
    margin-top: 4px;
    color: var(--mute);
    font-size: 14px;
    line-height: 1.7;
  }

  .realm-map-count {
    color: var(--fg);
    font: 400 15px var(--f-mono);
    white-space: nowrap;
  }

  .realm-map-count small {
    margin-left: 6px;
    color: var(--mute);
    font-size: 12px;
  }

  .realm-map-empty {
    color: var(--mute);
  }
}

// 读书 shelf (scripts/signal-books.js): one row per book, the progress is a
// hairline track filled in cyan; finished books settle to --mute.
@css {
  .shelf {
    margin: 36px 0 0;
    border-top: 1px solid var(--line);
    padding: 0;
    list-style: none;
  }

  .shelf-item {
    margin: 0;
    border-bottom: 1px solid var(--line);
  }

  .posts-collapse .post-content .shelf-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 8px 24px;
    align-items: baseline;
    padding: 22px 4px;
    border: 0;
    color: var(--text);
  }

  .shelf-title {
    color: var(--fg);
    font: 700 22px/1.3 var(--f-cn-display);
    transition: color var(--t-fast) var(--ease);
  }

  .shelf-row:hover .shelf-title {
    color: var(--cyan);
  }

  .shelf-meta {
    color: var(--mute);
    font-size: 13px;
    text-align: right;
  }

  .shelf-bar {
    position: relative;
    align-self: center;
    height: 2px;
    background: var(--line);
  }

  .shelf-bar span {
    position: absolute;
    inset: 0 auto 0 0;
    background: var(--cyan);
  }

  .is-done .shelf-bar span {
    background: var(--mute);
  }

  .shelf-pages {
    color: var(--mute);
    font: 12px var(--f-mono);
    text-align: right;
    white-space: nowrap;
  }
}

// The same trail, compact, inside the 读书 row on 疆域.
@css {
  .shelf-when {
    grid-column: 1 / -1;
    color: var(--mute);
    font: 12px var(--f-mono);
  }

  .shelf-trail {
    display: grid;
    gap: 10px;
    margin-top: 14px;
  }

  .shelf-trail-item {
    display: grid;
    grid-template-columns: minmax(6em, max-content) minmax(60px, 1fr) auto;
    gap: 14px;
    align-items: center;
  }

  .shelf-trail-title {
    color: var(--text);
    font-size: 14px;
  }
}
