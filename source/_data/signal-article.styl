// SIGNAL reader: post header, body typography, alerts, code, related posts,
// discussion and image zoom. Features come from scripts/post-render-enhancements.js
// and source/js/post-enhancements.js; only their look lives here.
@css {
  /* About 40 Chinese characters a line; --post-w also places the TOC rail. */
  .main-inner.post {
    max-width: var(--post-w);
  }

  .posts-expand .post-header {
    margin-bottom: 44px;
    text-align: left;
  }

  .posts-expand .post-title {
    margin: 0 0 22px;
    color: var(--fg);
    font: 900 clamp(34px, 5vw, 62px)/1.2 var(--f-cn-display);
    text-wrap: balance;
    /* Lines end between words: scripts/signal-typeset.js marks them. */
    word-break: keep-all;
    overflow-wrap: anywhere;
  }

  .posts-expand .post-title-link {
    border: 0;
    color: var(--fg);
  }

  .posts-expand .post-title-link::before {
    background: var(--cyan);
  }

  .post-meta-container {
    margin-top: 0;
  }

  .posts-expand .post-meta,
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: 4px 16px;
    color: var(--mute);
    font: 12px var(--f-mono);
  }

  .post-meta-item {
    margin: 0;
  }

  .post-meta-item::before,
  .post-meta-item-icon {
    display: none;
  }

  .post-meta a {
    border-bottom: 1px solid var(--line-2);
    color: var(--cyan);
  }

  .posts-expand .post-meta-container time {
    border-bottom: 0;
  }

  .posts-expand .post-header .post-description {
    max-width: 60ch;
    font-family: var(--f-body);
    margin: 26px 0 0;
    padding-left: 18px;
    border-left: 2px solid var(--violet);
    color: var(--mute);
    font-size: 18px;
    line-height: 1.7;
    text-align: left;
  }

  .posts-expand .post-header::after {
    content: "";
    display: block;
    height: 1px;
    margin-top: 36px;
    background: var(--signal-line);
  }

  /* ───── Body ───── */
  .post-body {
    color: var(--text);
    font-family: var(--f-body);
    font-size: 16.5px;
    line-height: 1.9;
  }

  .post-body p {
    margin: 0 0 1.1em;
  }

  .post-body a {
    border-bottom: 1px solid rgba(124, 236, 255, .3);
    color: var(--cyan);
  }

  .post-body a:hover {
    border-bottom-color: var(--cyan);
    color: #fff;
  }

  .post-body h1,
  .post-body h2,
  .post-body h3,
  .post-body h4,
  .post-body h5,
  .post-body h6 {
    padding: 0;
    border: 0;
    color: var(--fg);
    font-family: var(--f-cn-display);
    font-weight: 700;
    line-height: 1.4;
  }

  .post-body h2 {
    margin: 52px 0 14px;
    font-size: 26px;
  }

  .post-body h3 {
    margin: 36px 0 12px;
    font-size: 20px;
  }

  .post-body h4 {
    margin: 28px 0 10px;
    padding-left: 11px;
    border-left: 2px solid var(--cyan);
    font-size: 17px;
  }

  .post-body h5 {
    color: #bec5e4;
    font-size: 16px;
  }

  .post-body h6 {
    color: var(--mute);
    font-size: 15px;
    letter-spacing: .04em;
  }

  .post-body .headerlink {
    border: 0;
  }

  .post-body .headerlink::before {
    color: var(--mute);
  }

  .post-body ul,
  .post-body ol {
    padding-left: 1.4em;
  }

  .post-body li::marker {
    color: var(--mute);
  }

  .post-body blockquote {
    margin: 24px 0;
    padding: 2px 0 2px 18px;
    border-left: 2px solid var(--line-2);
    background: none;
    color: var(--mute);
  }

  .post-body hr {
    height: 1px;
    margin: 40px 0;
    border: 0;
    background: var(--line);
  }

  /* Screenshots come in every colour; a hairline frame, a soft corner and
     a touch less light make them sit on the page. Full light when pointed
     at, and in the zoom view. */
  .post-body img {
    border: 1px solid var(--line-2);
    border-radius: 4px;
    filter: brightness(.9);
    transition: filter var(--t-fast) var(--ease);
  }

  .post-body img:hover {
    filter: none;
  }

  .post-body table {
    border: 1px solid var(--line);
    font-size: 14.5px;
  }

  .post-body th {
    border-color: var(--line);
    background: var(--ink-2);
    color: var(--fg);
    font: 600 12px var(--f-mono);
    letter-spacing: .06em;
  }

  .post-body td {
    border-color: var(--line);
  }

  .post-body :not(pre) > code {
    padding: 1px 6px;
    border: 1px solid var(--line);
    border-radius: 0;
    background: var(--ink-2);
    color: #d6dbf0;
    font: .86em var(--f-mono);
    overflow-wrap: anywhere;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  /* ───── Code blocks ───── */
  .post-body figure.highlight,
  .post-body .post-code-container {
    max-width: 100%;
    box-sizing: border-box;
    margin: 24px 0;
    border: 1px solid var(--line-2);
    border-radius: 0;
    background: #080a12;
    box-shadow: none;
  }

  .post-body .code-container {
    position: relative;
    padding-top: 36px;
  }

  .post-body .code-container::before {
    content: "";
    position: absolute;
    top: 35px;
    right: 0;
    left: 0;
    height: 1px;
    background: var(--line);
  }

  /* A single line of code needs no title bar and no line number. */
  .post-body .code-container:not(:has(td.code .line ~ .line)) {
    padding-top: 0;
  }

  .post-body .code-container:not(:has(td.code .line ~ .line))::before,
  .post-body .code-container:not(:has(td.code .line ~ .line)) .code-lang,
  .post-body .code-container:not(:has(td.code .line ~ .line)) .gutter {
    display: none;
  }

  .post-body .code-container:not(:has(td.code .line ~ .line)) .copy-btn {
    top: 50%;
    transform: translateY(-50%);
    background: #080a12 !important;
  }

  .post-body figure.highlight .table-container,
  .post-body pre {
    overflow-x: auto;
  }

  .post-body pre,
  .post-body .highlight pre,
  .post-body .highlight .gutter pre,
  .post-body .highlight .code pre {
    background: #080a12;
    font: 13.5px/1.75 var(--f-mono);
    tab-size: 2;
  }

  .post-body .highlight .gutter pre {
    color: #3c4460;
  }

  /* Chinese in code: a fixed two-column cell, so boxes drawn with │ ─ line up
     (alignWideChars in scripts/post-render-enhancements.js). NexT's utils.js
     renames span classes in code to hljs-*, so .wide arrives as .hljs-wide. */
  .post-body .highlight .wide,
  .post-body .highlight .hljs-wide {
    display: inline-block;
    width: 2ch;
    text-align: center;
  }

  /* Blocks without line numbers: shell sessions and plain output. */
  .post-body .highlight td.code:first-child pre,
  .post-body .highlight td.output pre {
    padding-left: 16px;
  }

  /* Shell sessions (scripts/post-render-enhancements.js): a $ prompt instead
     of line numbers, and the output in the same frame, a step quieter. The
     prompt is generated content, so copying leaves it out. */
  .post-body .terminal .line.cmd::before {
    content: "$ ";
    color: var(--cyan);
  }

  .post-body .terminal tr:has(+ tr) td.code pre {
    padding-bottom: 0;
  }

  .post-body .terminal td.output pre {
    padding-top: 4px;
    color: #9aa3bf;
  }

  .post-body figure.highlight .table-container.is-clipped {
    -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 56px), transparent);
    mask-image: linear-gradient(to right, #000 calc(100% - 56px), transparent);
  }

  /* Same address (source/js/post-enhancements.js): the address or name under
     the mouse, and every other place in the post's code that holds it.
     Highlight styles take literal colours, not the tokens. */
  ::highlight(signal-same) {
    background-color: rgba(124, 236, 255, .16);
    color: #e7eaf4;
  }

  ::highlight(signal-here) {
    background-color: rgba(124, 236, 255, .34);
    color: #fff;
  }

  .post-body .highlight table,
  .post-body .highlight td {
    border: 0;
    background: none;
  }

  .post-body .code-lang {
    top: 0 !important;
    right: auto !important;
    left: 14px;
    max-width: calc(100% - 120px);
    height: 36px;
    overflow: hidden;
    padding: 0;
    border: 0;
    background: none;
    color: var(--mute);
    font: 11px/36px var(--f-mono) !important;
    letter-spacing: .1em;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
    opacity: 1 !important;
  }

  .post-body .copy-btn {
    top: 6px;
    right: 8px;
    z-index: 4;
    display: inline-flex;
    min-width: 0;
    min-height: 0;
    align-items: center;
    padding: 3px 10px;
    border: 1px solid var(--line-2);
    border-radius: 2px;
    background: none !important;
    color: var(--fg) !important;
    font: 11px var(--f-mono);
    opacity: .85;
  }

  /* Text labels instead of Font Awesome glyphs, so the button reads even when the icon CDN is slow. */
  .post-body .copy-btn i {
    display: none;
  }

  .post-body .copy-btn::before {
    content: "COPY";
    letter-spacing: .08em;
  }

  .post-body .copy-btn:has(.fa-check-circle)::before {
    content: "COPIED";
    color: var(--green);
  }

  .post-body .copy-btn:has(.fa-times-circle)::before {
    content: "FAILED";
    color: var(--rose);
  }

  .post-body .copy-btn:hover,
  .post-body .copy-btn:focus-visible {
    border-color: var(--cyan);
    opacity: 1;
  }

  .post-body .post-code-container > pre {
    margin: 0;
    padding: 46px 16px 16px;
  }

  @media (any-hover: none), (pointer: coarse) {
    .post-body .copy-btn {
      min-height: 30px;
      opacity: 1;
    }
  }

  /* ───── Alerts and the stale notice ───── */
  .markdown-alert,
  .post-stale-notice {
    --alert-color: var(--cyan);
    margin: 24px 0;
    padding: 14px 18px;
    border: 1px solid rgba(124, 236, 255, .4);
    border-color: color-mix(in srgb, var(--alert-color) 45%, transparent);
    border-radius: 0;
    background: var(--ink);
    box-shadow: none;
    color: var(--text);
    font-size: 15px;
  }

  .markdown-alert p {
    margin: 6px 0;
  }

  .markdown-alert .markdown-alert-title {
    display: block;
    margin: 0 0 4px;
    color: var(--alert-color);
    font: 600 12px var(--f-mono);
    letter-spacing: .14em;
  }

  .markdown-alert .markdown-alert-title span {
    display: none;
  }

  .markdown-alert .markdown-alert-body > :first-child {
    margin-top: 0;
  }

  .markdown-alert .markdown-alert-body > :last-child {
    margin-bottom: 0;
  }

  .markdown-alert-note {
    --alert-color: var(--cyan);
  }

  .markdown-alert-note .markdown-alert-title::before {
    content: "NOTE · ";
  }

  .markdown-alert-tip {
    --alert-color: var(--green);
  }

  .markdown-alert-tip .markdown-alert-title::before {
    content: "TIP · ";
  }

  .markdown-alert-important {
    --alert-color: var(--violet);
  }

  .markdown-alert-important .markdown-alert-title::before {
    content: "IMPORTANT · ";
  }

  .markdown-alert-warning {
    --alert-color: var(--heat);
  }

  .markdown-alert-warning .markdown-alert-title::before {
    content: "WARNING · ";
  }

  .markdown-alert-caution {
    --alert-color: var(--rose);
  }

  .markdown-alert-caution .markdown-alert-title::before {
    content: "CAUTION · ";
  }

  .post-stale-notice {
    --alert-color: var(--heat);
    display: block;
    margin: 0 0 30px;
  }

  .post-stale-notice::before {
    content: "STALE · 时效提示";
    display: block;
    margin-bottom: 4px;
    color: var(--heat);
    font: 600 12px var(--f-mono);
    letter-spacing: .14em;
  }

  .post-stale-notice-icon {
    display: none;
  }

  .post-stale-notice p {
    margin: 0;
  }

  .post-stale-notice em {
    font-style: normal;
  }

  /* ───── Post footer ───── */
  /* Reading order at the end of a post: tags, then where to go next
     (previous / next, related), then the discussion. */
  .post-footer {
    display: flex;
    flex-direction: column;
    margin-top: 20px;
  }

  .post-footer > .signal-rest,
  .post-footer > .signal-eof {
    order: 0;
  }

  .post-footer > .post-tags {
    order: 1;
  }

  .post-footer > .post-nav {
    order: 2;
  }

  .post-footer > .related-posts-section {
    order: 3;
  }

  .post-footer > .post-community {
    order: 4;
  }

  /* The signal comes to rest (source/_data/post-body-end.njk): a wave that
     settles into a flat line, and the moon at the end of it. This is the
     only place the moon shows outside the home page. Where the browser
     can, the line draws itself and the moon comes out as they scroll into
     view. */
  .signal-rest {
    position: relative;
    margin: 72px 0 0;
    padding-right: 112px;
  }

  .signal-rest svg {
    display: block;
    width: 100%;
    height: 40px;
    overflow: visible;
  }

  .signal-rest path {
    fill: none;
    stroke: url(#signal-rest-ink);
    stroke-width: 1.2;
    stroke-dasharray: 1;
    vector-effect: non-scaling-stroke;
  }

  .post-body .signal-rest-moon,
  .signal-rest-moon {
    position: absolute;
    right: 0;
    bottom: 2px;
    width: 96px;
    height: auto;
    margin: 0;
    border: 0;
    border-radius: 0;
    filter: drop-shadow(0 0 18px rgba(255, 214, 170, .22));
    pointer-events: none;
    user-select: none;
  }

  @media (max-width: 567px) {
    .signal-rest {
      padding-right: 84px;
    }

    .signal-rest-moon {
      width: 72px;
    }
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .signal-rest path {
        animation: signal-draw linear both;
        animation-timeline: view();
        animation-range: entry 20% cover 40%;
      }

      .signal-rest-moon {
        animation: signal-moonrise linear both;
        animation-timeline: view();
        animation-range: cover 30% cover 50%;
      }

      @keyframes signal-draw {
        from {
          stroke-dashoffset: 1;
        }
        to {
          stroke-dashoffset: 0;
        }
      }

      @keyframes signal-moonrise {
        from {
          opacity: 0;
          transform: translateY(8px);
        }
        to {
          opacity: 1;
          transform: none;
        }
      }
    }
  }

  /* Hidden entrance: a hair brighter than the page until pointed at. */
  .signal-eof {
    margin: 36px 0 0;
    font: 11px var(--f-mono);
    letter-spacing: .2em;
  }

  .signal-eof a,
  .posts-expand .post-body .signal-eof a {
    color: var(--ink-2);
    border: 0;
    text-decoration: none;
    transition: color .4s, text-shadow .4s;
  }

  .signal-eof a:hover,
  .signal-eof a:focus-visible {
    color: var(--cyan);
    text-shadow: 0 0 12px rgba(124, 236, 255, .45);
  }

  .post-tags {
    margin-top: 44px;
    font: 12px var(--f-mono);
  }

  .post-tags a,
  .posts-expand .post-tags a {
    margin: 0 10px 6px 0;
    padding: 0;
    border: 0;
    background: none;
    color: var(--mute);
    font-size: 12px;
    transition: color var(--t-fast) var(--ease);
  }

  .post-tags a:hover {
    color: var(--cyan);
  }

  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin-top: 28px;
    padding-top: 0;
    border-top: 0;
  }

  .post-nav-item {
    min-width: 0;
  }

  .post-nav-item a {
    display: block;
    padding: 14px 4px;
    border: 0;
    border-top: 1px solid var(--line);
    background: none;
    color: var(--text);
    font-size: 14.5px;
    line-height: 1.5;
    transition: color var(--t-fast) var(--ease);
  }

  .post-nav-item a:hover {
    color: var(--cyan);
  }

  .post-nav-item:last-child a {
    text-align: right;
  }

  .post-nav-item i {
    color: var(--mute);
  }

  .related-posts-section,
  .post-community {
    margin-top: 72px;
  }

  .related-posts-section h2,
  .post-community-heading h2 {
    margin: 0 0 18px;
    padding: 0;
    border: 0;
    color: var(--fg);
    font: 700 24px/1.4 var(--f-cn-display);
  }

  .related-posts-section h2 small,
  .post-community-heading h2 small {
    margin-left: 12px;
    color: var(--mute);
    font: italic 500 18px var(--f-poem);
  }

  .related-posts-list {
    margin: 0;
    border-top: 1px solid var(--line);
    padding: 0;
    list-style: none;
  }

  .related-posts-list li {
    margin: 0;
    border-bottom: 1px solid var(--line);
  }

  .related-post {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 20px;
    align-items: baseline;
    padding: 14px 4px;
    border: 0;
    color: var(--fg);
  }

  .related-post-title {
    transition: color var(--t-fast) var(--ease);
  }

  .related-post:hover .related-post-title {
    color: var(--cyan);
  }

  .related-post time {
    color: var(--mute);
    font: 12px var(--f-mono);
    font-variant-numeric: tabular-nums;
  }

  .post-community-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
  }

  .post-community-intro {
    margin: 0 0 22px;
    color: var(--mute);
    font-size: 14px;
  }

  .post-error-report {
    display: inline-flex;
    min-height: 40px;
    box-sizing: border-box;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border: 1px solid var(--line-2) !important;
    border-radius: 2px;
    background: none;
    color: var(--fg) !important;
    font: 12px var(--f-mono);
    letter-spacing: .06em;
  }

  .post-error-report:hover {
    border-color: var(--cyan) !important;
    background: rgba(124, 236, 255, .06);
  }

  .giscus,
  .giscus-frame {
    width: 100%;
  }

  @media (max-width: 767px) {
    .post-body {
      font-size: 16px;
    }

    .post-nav {
      grid-template-columns: 1fr;
    }

    .post-community-heading {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  /* ───── Image zoom ───── */
  .post-image-zoomable {
    cursor: zoom-in;
  }

  .image-zoom-overlay {
    position: fixed;
    inset: 0;
    z-index: 2147483646;
    display: grid;
    place-items: center;
    padding: 24px;
    background: rgba(5, 6, 11, .94);
    opacity: 0;
    transition: opacity var(--t-fast) var(--ease);
  }

  .image-zoom-overlay.is-open {
    opacity: 1;
  }

  .image-zoom-figure {
    display: grid;
    max-width: min(94vw, 1440px);
    max-height: 92dvh;
    margin: 0;
    place-items: center;
  }

  .image-zoom-figure img {
    max-width: 100%;
    max-height: calc(92dvh - 44px);
    object-fit: contain;
    border: 1px solid var(--line);
  }

  .image-zoom-figure figcaption {
    margin-top: 10px;
    color: var(--mute);
    font-size: 13px;
    text-align: center;
  }

  .image-zoom-close {
    position: fixed;
    top: calc(14px + env(safe-area-inset-top, 0px));
    right: calc(14px + env(safe-area-inset-right, 0px));
    z-index: 1;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--line-2);
    border-radius: 50%;
    background: var(--ink);
    color: var(--fg);
    font-size: 1.6em;
    line-height: 1;
    cursor: var(--cursor-pointer, pointer);
  }

  body.image-zoom-open {
    overflow: hidden;
  }

  /* Section headings and figures rise into place as they scroll in
     (scroll-driven, see signal-home.styl). */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .post-body > h2,
      .post-body > h3,
      .post-body .image-zoom,
      .post-body > p > img {
        animation: signal-rise linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 60%;
      }
    }
  }
}
