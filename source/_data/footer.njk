{#- The footer: the signal comes to rest as a flat line (the footer's top
    edge, signal-base.styl), then one quiet row. The day count is worked out
    once when the page loads; visitor counts show only once they arrive
    (source/js/visitor-count.js). -#}
<div class="signal-coda">
  <em class="signal-coda-sign">Coda.</em>
{%- if config.blog_runtime and config.blog_runtime.enable %}
  <span class="blog-runtime" data-blog-runtime data-since="{{ config.blog_runtime.since }}" hidden>本站已运行 <b data-runtime-days>0</b> 天</span>
{%- endif %}
  <span class="blog-visitors" data-blog-visitors hidden>访客 <b id="vercount_value_site_uv" translate="no"></b> · 浏览 <b id="vercount_value_site_pv" translate="no"></b></span>
</div>
{%- if config.blog_runtime and config.blog_runtime.enable %}
<script>
(function() {
  var runtime = document.querySelector('[data-blog-runtime]');
  if (!runtime) return;
  var startedAt = Date.parse(runtime.dataset.since);
  if (!isFinite(startedAt)) return;
  runtime.querySelector('[data-runtime-days]').textContent = String(Math.max(0, Math.floor((Date.now() - startedAt) / 86400000)));
  runtime.hidden = false;
})();
</script>
{%- endif %}
