// The four menu pages as four districts of the backdrop's rainy city
// (scripts/signal-channels.js): 札记 档案街, 远征 轨道站, 疆域 城区, 漫游 城外.
// Shared: a district tag, the title lit as a neon tube, and the metro line at the end with this page as the lit stop.
// Each district has its own neon colour and its own body.
@css {
  :root {
    --ch-1: var(--cyan);
    --ch-2: var(--violet);
    --ch-3: var(--rose);
    --ch-4: var(--green);
  }

  [data-ch="log"],
  body:has(.signal-district[data-ch="log"]) { --ch: var(--ch-1); }
  [data-ch="route"],
  body:has(.signal-district[data-ch="route"]) { --ch: var(--ch-2); }
  [data-ch="map"],
  body:has(.signal-district[data-ch="map"]) { --ch: var(--ch-3); }
  [data-ch="drift"],
  body:has(.signal-district[data-ch="drift"]) { --ch: var(--ch-4); }

  /* ───── Page head: district tag, neon title, hanging sign ───── */
  .page .post-header:has(.signal-district),
  .archive-page-header:has(.signal-district) {
    position: relative;
  }

  .signal-district-tag {
    display: inline-block;
    margin-bottom: 12px;
    padding: 3px 8px;
    border: 1px solid color-mix(in srgb, var(--ch) 50%, transparent);
    color: var(--ch);
    font: 11px var(--f-mono);
    letter-spacing: .2em;
  }

  /* The title as a lit neon tube: white core, coloured glow. */
  body:has(.signal-district) .page .post-title,
  body:has(.signal-district) .archive-page-header h1 {
    color: color-mix(in srgb, var(--ch) 18%, #fff);
    text-shadow:
      0 0 2px #fff,
      0 0 10px var(--ch),
      0 0 26px color-mix(in srgb, var(--ch) 70%, transparent),
      0 0 60px color-mix(in srgb, var(--ch) 40%, transparent);
  }

  body:has(.signal-district) .page .post-title .post-title-sub,
  body:has(.signal-district) .archive-page-header h1 small {
    text-shadow: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    body:has(.signal-district) .page .post-title,
    body:has(.signal-district) .archive-page-header h1 {
      animation: signal-neon-on 1.4s steps(1, end) .2s both;
    }
  }

  @keyframes signal-neon-on {
    0% { opacity: .15; text-shadow: none; }
    12% { opacity: 1; }
    18% { opacity: .2; text-shadow: none; }
    30% { opacity: 1; }
    36% { opacity: .35; text-shadow: none; }
    48% { opacity: 1; }
  }

  /* ───── Metro line: the four districts, this one lit ───── */
  .signal-metro {
    margin: 80px 0 0;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }

  .signal-metro-head {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 22px;
    color: var(--mute);
    font: 11px var(--f-mono);
    letter-spacing: .18em;
  }

  .signal-metro-head span[data-ch] {
    color: var(--ch);
  }

  .post-body .signal-metro ol,
  .signal-metro ol {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .signal-metro li {
    position: relative;
    margin: 0;
  }

  /* The track: each stop draws the segment to its right in its own colour. */
  .signal-metro li::before {
    content: "";
    position: absolute;
    top: 9px;
    left: 9px;
    right: -9px;
    height: 4px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--ch), color-mix(in srgb, var(--ch) 40%, transparent));
    opacity: .55;
  }

  .signal-metro li:last-child::before {
    right: 0;
    background: linear-gradient(90deg, var(--ch), transparent);
  }

  .signal-metro a,
  .post-body .signal-metro a {
    position: relative;
    display: grid;
    gap: 6px;
    justify-items: start;
    border: 0;
    color: var(--mute);
  }

  .signal-metro a i {
    width: 22px;
    height: 22px;
    border: 4px solid var(--ch);
    border-radius: 50%;
    background: var(--void);
    transition: box-shadow .2s;
  }

  .signal-metro b {
    margin-top: 6px;
    color: var(--text);
    font: 700 20px/1.2 var(--f-cn-display);
    transition: color .2s;
  }

  .signal-metro small {
    font: 10px var(--f-mono);
    letter-spacing: .16em;
  }

  .signal-metro a:hover b {
    color: var(--ch);
  }

  .signal-metro a:hover i {
    box-shadow: 0 0 12px var(--ch);
  }

  .signal-metro li.is-here i {
    background: var(--ch);
    box-shadow: 0 0 0 4px var(--void), 0 0 0 5px var(--ch), 0 0 18px var(--ch);
  }

  .signal-metro li.is-here b {
    color: #fff;
    text-shadow: 0 0 10px var(--ch);
  }

  .signal-metro li.is-here small {
    color: var(--ch);
  }

  @media (max-width: 567px) {
    .signal-metro b {
      font-size: 16px;
    }

    .signal-metro small {
      display: none;
    }

    .signal-metro li.is-here small {
      display: block;
      font-size: 9px;
      letter-spacing: .08em;
    }
  }
  /* ───── 札记 LOG: a timeline, one tick per entry ───── */
  body:has(.signal-district[data-ch="log"]) .archive-post-list li {
    position: relative;
    padding-left: 30px;
    border-top-color: transparent;
  }

  body:has(.signal-district[data-ch="log"]) .archive-post-list li::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 9px;
    width: 1px;
    background: color-mix(in srgb, var(--ch) 28%, transparent);
  }

  body:has(.signal-district[data-ch="log"]) .archive-post-list li::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 6px;
    width: 7px;
    height: 7px;
    margin-top: -3.5px;
    border: 1px solid var(--ch);
    background: var(--void);
    transition: background .2s, box-shadow .2s;
  }

  body:has(.signal-district[data-ch="log"]) .archive-post-list li:hover::after {
    background: var(--ch);
    box-shadow: 0 0 10px var(--ch);
  }

  body:has(.signal-district[data-ch="log"]) .archive-post-list time {
    color: var(--ch);
  }

  body:has(.signal-district[data-ch="log"]) .archive-post-list a:hover {
    color: var(--ch);
  }

  /* ───── 远征 ROUTE: cards keep their graphs, take the channel colour ───── */
  body:has(.signal-district[data-ch="route"]) .learning-path-card {
    border-left: 2px solid var(--ch);
  }

  body:has(.signal-district[data-ch="route"]) .learning-paths-stats strong {
    color: var(--ch);
  }

  /* Each card wears its line badge from the departure board. */
  body:has(.signal-district[data-ch="route"]) .learning-path-card-index {
    padding: 3px 7px;
    border-radius: 3px;
    background: var(--ch);
    color: var(--void);
    font-weight: 700;
    letter-spacing: .06em;
  }

  /* ───── 疆域 MAP: a memory map of the realms ───── */
  .realm-map-space {
    margin: 0 0 30px;
  }

  .realm-map-axis {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 8px;
    color: var(--mute);
    font: 11px var(--f-mono);
    letter-spacing: .12em;
  }

  .realm-map-axis span:nth-child(2) {
    color: var(--ch);
    text-align: center;
  }

  .realm-map-bar {
    display: flex;
    gap: 3px;
    height: 34px;
  }

  .realm-map-seg {
    position: relative;
    min-width: 30px;
    border: 1px solid var(--ch);
    background: repeating-linear-gradient(135deg, color-mix(in srgb, var(--ch) 22%, transparent) 0 2px, transparent 2px 7px);
  }

  .realm-map-seg[data-seg="1"] {
    border-style: dashed;
    background: color-mix(in srgb, var(--ch) 8%, transparent);
  }

  .realm-map-seg i {
    position: absolute;
    top: 50%;
    left: 10px;
    transform: translateY(-50%);
    color: var(--fg);
    font: normal 600 12px var(--f-mono);
    letter-spacing: .14em;
  }

  .post-body .realm-map-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .realm-map-list li {
    margin: 0;
    border-bottom: 1px solid var(--line);
  }

  .post-body .realm-map-row {
    display: grid;
    grid-template-columns: 112px minmax(0, 1fr) 150px;
    gap: 6px 24px;
    align-items: center;
    padding: 24px 4px;
    border: 0;
    color: var(--text);
    transition: background .2s;
  }

  .post-body .realm-map-row:hover {
    background: color-mix(in srgb, var(--ch) 5%, transparent);
  }

  .realm-map-range {
    align-self: start;
    padding-top: 10px;
    color: var(--mute);
    font: 11px/1.6 var(--f-mono);
    letter-spacing: .06em;
  }

  .realm-map-range b {
    display: block;
    height: 0;
    overflow: hidden;
  }

  .realm-map-body {
    display: grid;
    gap: 4px;
  }

  .realm-map-name {
    color: var(--fg);
    font: 900 46px/1 var(--f-display);
    letter-spacing: .03em;
    transition: color .2s;
  }

  .realm-map-row:hover .realm-map-name {
    color: var(--ch);
  }

  .realm-map-epithet {
    color: var(--ch);
    font: italic 500 19px var(--f-poem);
  }

  .realm-map-desc {
    color: var(--mute);
    font-size: 14px;
    line-height: 1.7;
  }

  .realm-map-size {
    display: grid;
    gap: 8px;
    justify-items: end;
  }

  .realm-map-meter {
    width: 100%;
    height: 4px;
    background: var(--line);
  }

  .realm-map-meter span {
    display: block;
    height: 100%;
    margin-left: auto;
    background: var(--ch);
    box-shadow: 0 0 8px color-mix(in srgb, var(--ch) 60%, transparent);
  }

  .realm-map-count {
    color: var(--fg);
    font: 600 26px/1 var(--f-display);
  }

  .realm-map-count small {
    margin-left: 6px;
    color: var(--mute);
    font: 11px var(--f-mono);
    letter-spacing: .14em;
  }

  @media (max-width: 567px) {
    .post-body .realm-map-row {
      grid-template-columns: minmax(0, 1fr) 96px;
    }

    .realm-map-range {
      grid-column: 1 / -1;
      padding: 0;
    }

    .realm-map-range b {
      display: inline;
      height: auto;
      margin: 0 4px;
      font-weight: 400;
    }

    .realm-map-name {
      font-size: 38px;
    }

    .realm-map-axis span:nth-child(2) {
      display: none;
    }
  }

  /* ───── 漫游 城外: highway exit signs out of the city ───── */
  body:has(.signal-district[data-ch="drift"]) .post-body .wander-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 360px), 1fr));
    gap: 34px 20px;
    margin-top: 26px;
    border: 0;
  }

  body:has(.signal-district[data-ch="drift"]) .wander-list li {
    display: flex;
    border: 0;
  }

  body:has(.signal-district[data-ch="drift"]) .post-body .wander-site {
    position: relative;
    flex: 1;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 10px 16px;
    padding: 22px 22px 18px;
    border: 2px solid color-mix(in srgb, var(--ch) 75%, #fff);
    border-radius: 10px;
    outline: 4px solid color-mix(in srgb, var(--ch) 14%, #04140c);
    background: color-mix(in srgb, var(--ch) 14%, #04140c);
    box-shadow: 0 0 22px color-mix(in srgb, var(--ch) 25%, transparent);
    color: #e9fff3;
    transition: box-shadow .25s, transform .25s;
  }

  /* The EXIT tab on top of the sign. */
  body:has(.signal-district[data-ch="drift"]) .post-body .wander-site::before {
    content: attr(data-loc) / "";
    position: absolute;
    top: -15px;
    left: 18px;
    padding: 3px 10px;
    border: 2px solid color-mix(in srgb, var(--ch) 75%, #fff);
    border-radius: 6px;
    background: color-mix(in srgb, var(--ch) 22%, #04140c);
    color: #fff;
    font: 600 11px var(--f-mono);
    letter-spacing: .16em;
  }

  body:has(.signal-district[data-ch="drift"]) .post-body .wander-site::after {
    content: "↗";
    grid-column: 2;
    grid-row: 1;
    color: #fff;
    font: 700 34px/1 var(--f-body);
    transition: transform .25s;
  }

  body:has(.signal-district[data-ch="drift"]) .post-body .wander-site:hover {
    box-shadow: 0 0 34px color-mix(in srgb, var(--ch) 45%, transparent);
  }

  body:has(.signal-district[data-ch="drift"]) .wander-site:hover::after {
    transform: translate(4px, -4px);
  }

  body:has(.signal-district[data-ch="drift"]) .wander-name {
    grid-column: 1;
    grid-row: 1;
    color: #fff;
    font: 700 26px/1.25 var(--f-cn-display);
  }

  body:has(.signal-district[data-ch="drift"]) .wander-site:hover .wander-name {
    color: #fff;
  }

  body:has(.signal-district[data-ch="drift"]) .wander-description {
    grid-column: 1 / -1;
    grid-row: 2;
    color: color-mix(in srgb, var(--ch) 30%, #fff);
    opacity: .85;
  }

  body:has(.signal-district[data-ch="drift"]) .wander-host {
    grid-column: 1 / -1;
    grid-row: 3;
    padding-top: 10px;
    border-top: 1px solid color-mix(in srgb, var(--ch) 40%, transparent);
    color: color-mix(in srgb, var(--ch) 60%, #fff);
    text-align: left;
  }
}
