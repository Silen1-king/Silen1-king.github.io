// SIGNAL secondary pages: archive tree, category/tag lists, tag cloud,
// learning paths and the 404 page.
@css {
  .page .post-header,
  .posts-collapse .collection-title {
    margin-bottom: 40px;
    text-align: left;
  }

  .collection-title {
    padding: 0;
    border: 0;
  }

  .collection-title::before {
    display: none;
  }

  .page .post-title,
  .posts-collapse .collection-title .collection-header {
    margin: 0;
    color: var(--fg);
    font: 900 clamp(40px, 6vw, 72px)/1.1 var(--f-cn-display);
    letter-spacing: .04em;
  }

  .posts-collapse .collection-title .collection-header small {
    display: block;
    margin-top: 10px;
    color: var(--mute);
    font: italic 500 22px var(--f-poem);
    letter-spacing: 0;
  }

  /* ───── Category / tag post lists ───── */
  .posts-collapse .post-content {
    margin-left: 0;
    padding-left: 0;
    border-left: 0;
  }

  .posts-collapse .post-content::before {
    display: none;
  }

  .posts-collapse .post-content .collection-year {
    margin: 36px 0 0;
    padding: 0 0 10px;
    border-bottom: 1px solid var(--line);
  }

  .posts-collapse .post-content .collection-year::before {
    display: none;
  }

  .posts-collapse .post-content .collection-year .collection-header {
    color: var(--cyan);
    font: 12px var(--f-mono);
    letter-spacing: .2em;
  }

  .posts-collapse .post-content .post-header {
    display: grid;
    grid-template-columns: 70px minmax(0, 1fr);
    align-items: baseline;
    gap: 16px;
    margin: 0;
    padding: 16px 4px;
    border-bottom: 1px solid var(--line);
  }

  .posts-collapse .post-content .post-header::before {
    display: none;
  }

  .posts-collapse .post-content .post-meta-container {
    color: var(--mute);
    font: 12px var(--f-mono);
  }

  .posts-collapse .post-content .post-title {
    margin: 0;
    font: 700 18px/1.5 var(--f-cn-display);
  }

  .posts-collapse .post-content .post-title a {
    border: 0;
    color: var(--fg);
  }

  .posts-collapse .post-content .post-title a:hover {
    color: #fff;
  }

  .posts-collapse .post-content .post-title a::before {
    display: none;
  }

  /* ───── Tag cloud & category list ───── */
  .tag-cloud,
  .category-all-page {
    text-align: left;
  }

  .tag-cloud-title,
  .category-all-title {
    margin-bottom: 18px;
    color: var(--mute);
    font: 12px var(--f-mono);
    letter-spacing: .1em;
    text-align: left;
  }

  .tag-cloud-tags {
    text-align: left;
  }

  .tag-cloud-tags a {
    display: inline-block;
    margin: 6px 14px 6px 0;
    border: 0;
    color: var(--violet);
    font-family: var(--f-mono);
  }

  .tag-cloud-tags a::before {
    content: "#";
    color: var(--mute);
  }

  .tag-cloud-tags a:hover {
    color: #fff;
  }

  .category-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .category-list-item {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin: 0;
    padding: 18px 4px;
    border-bottom: 1px solid var(--line);
  }

  .category-list-link {
    border: 0;
    color: var(--fg);
    font: 900 40px/1 var(--f-display);
    letter-spacing: .03em;
  }

  .category-list-count {
    color: var(--cyan);
    font: 12px var(--f-mono);
  }

  .category-list-count::before {
    content: "ENTRIES ";
    color: var(--mute);
  }

  .category-list-child {
    padding-left: 20px;
  }

  /* ───── Archive tree (themes/next/layout/archive.njk) ───── */
  .archive-accordion .archive-block {
    padding: 0;
  }

  .archive-page-header {
    margin-bottom: 40px;
    text-align: left;
  }

  .archive-page-header h1 {
    margin: 8px 0 10px;
    color: var(--fg);
    font: 900 clamp(40px, 6vw, 72px)/1.1 var(--f-cn-display);
    letter-spacing: .04em;
  }

  .archive-page-header p {
    margin: 0;
    color: var(--mute);
  }

  .archive-page-kicker {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--mute);
    font: 12px var(--f-mono);
    letter-spacing: .22em;
  }

  .archive-page-kicker::before {
    content: "";
    width: 28px;
    height: 1px;
    background: var(--cyan);
  }

  .archive-tree {
    display: grid;
    gap: 14px;
  }

  .archive-year,
  .archive-month {
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--ink);
  }

  .archive-year > summary,
  .archive-month > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    list-style: none;
  }

  .archive-year > summary::-webkit-details-marker,
  .archive-month > summary::-webkit-details-marker {
    display: none;
  }

  .archive-year > summary::after,
  .archive-month > summary::after {
    content: "+";
    width: 25px;
    margin-left: 12px;
    color: var(--cyan);
    font: 16px var(--f-mono);
    text-align: center;
    transition: transform .2s ease;
  }

  .archive-year[open] > summary::after,
  .archive-month[open] > summary::after {
    transform: rotate(45deg);
  }

  .archive-year > summary {
    padding: 16px 20px;
  }

  .archive-year-name {
    margin-right: auto;
    color: var(--fg);
    font: 900 34px/1 var(--f-display);
  }

  .archive-panel-count {
    color: var(--mute);
    font: 12px var(--f-mono);
  }

  .archive-months {
    display: grid;
    gap: 10px;
    padding: 0 14px 14px;
  }

  .archive-month {
    background: var(--void);
  }

  .archive-month > summary {
    padding: 12px 15px;
  }

  .archive-month-name {
    margin-right: auto;
    color: var(--text);
    font: 12px var(--f-mono);
    letter-spacing: .1em;
  }

  .archive-post-list {
    margin: 0;
    padding: 0 16px 10px;
    list-style: none;
  }

  .archive-post-list li {
    display: grid;
    grid-template-columns: 58px minmax(0, 1fr);
    align-items: baseline;
    gap: 12px;
    padding: 10px 4px;
    border-top: 1px solid var(--line);
  }

  .archive-post-list time {
    color: var(--mute);
    font: 12px var(--f-mono);
    font-variant-numeric: tabular-nums;
  }

  .archive-post-list a {
    overflow: hidden;
    border: 0;
    color: var(--fg);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .archive-post-list a:hover {
    color: var(--cyan);
  }

  /* ───── Learning paths ───── */
  .learning-paths-intro {
    margin: 0 0 28px;
  }

  .learning-paths-intro p {
    display: none;
  }

  .learning-paths-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    color: var(--mute);
    font: 12px var(--f-mono);
  }

  .learning-paths-stats strong {
    color: var(--cyan);
    font-weight: 400;
  }

  .learning-path-grid {
    display: grid;
    gap: 28px;
  }

  .learning-path-card {
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--ink);
  }

  .learning-path-card-header {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 18px 20px;
    border-bottom: 1px solid var(--line);
  }

  .learning-path-card-header h2 {
    margin: 0;
    padding: 0;
    border: 0;
    color: var(--fg);
    font: 700 22px/1.3 var(--f-cn-display);
  }

  .learning-path-card-index {
    color: var(--cyan);
    font: 12px var(--f-mono);
    letter-spacing: .14em;
  }

  .learning-path-card-count {
    color: var(--mute);
    font: 12px var(--f-mono);
  }

  .learning-path-card .route-graph {
    border-width: 0 0 1px;
  }

  .learning-path-steps {
    margin: 0;
    padding: 6px 20px 14px;
    list-style: none;
  }

  .learning-path-step {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr);
    gap: 10px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
  }

  .learning-path-step:last-child {
    border-bottom: 0;
  }

  .learning-path-step-number {
    color: var(--cyan);
    font: 12px/1.9 var(--f-mono);
  }

  .learning-path-step-number::before {
    content: "#";
    color: var(--mute);
  }

  .learning-path-step-title {
    border: 0;
    color: var(--fg);
    font-weight: 500;
  }

  .learning-path-step-title:hover {
    color: var(--cyan);
  }

  .learning-path-step-date {
    display: block;
    color: var(--mute);
    font: 11px var(--f-mono);
  }

  .learning-path-step-description {
    margin: 4px 0 0;
    color: var(--mute);
    font-size: 14px;
    line-height: 1.7;
  }

  .learning-paths-empty {
    padding: 28px 0;
    color: var(--mute);
  }

  /* ───── 404 (source/404.md) ───── */
  .not-found-page {
    max-width: 640px;
    margin: 20px 0;
    text-align: left;
  }

  .not-found-code {
    display: block;
    color: transparent;
    font: 900 clamp(110px, 24vw, 220px)/.85 var(--f-display);
    -webkit-text-stroke: 1px var(--line-2);
  }

  .not-found-page h1 {
    margin: 18px 0 12px;
    color: var(--fg);
    font: 900 clamp(30px, 4vw, 44px)/1.25 var(--f-cn-display);
  }

  .not-found-page p {
    color: var(--mute);
    line-height: 1.8;
  }

  .not-found-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 26px;
  }

  .not-found-actions button,
  .not-found-actions a {
    display: inline-flex;
    min-height: 44px;
    box-sizing: border-box;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border: 1px solid var(--line-2) !important;
    border-radius: 2px;
    background: none;
    color: var(--fg) !important;
    font: 13px var(--f-mono);
    cursor: pointer;
  }

  .not-found-actions button {
    border-color: var(--fg) !important;
    background: var(--fg);
    color: var(--void) !important;
  }

  .not-found-actions a:hover {
    border-color: var(--cyan) !important;
  }

  @media (max-width: 767px) {
    .posts-collapse .post-content .post-header {
      grid-template-columns: 52px minmax(0, 1fr);
      gap: 10px;
    }

    .archive-post-list li {
      grid-template-columns: 48px minmax(0, 1fr);
      gap: 8px;
    }

    .not-found-actions {
      display: grid;
    }
  }
}
