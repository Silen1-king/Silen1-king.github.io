// SIGNAL secondary pages: archive tree, category/tag lists, tag cloud,
// learning paths and the 404 page.
@css {
  .page .post-header,
  .posts-collapse .collection-title {
    margin-bottom: 40px;
    text-align: left;
  }

  .collection-title {
    padding: 0;
    border: 0;
  }

  .collection-title::before {
    display: none;
  }

  .page .post-title,
  .posts-collapse .collection-title .collection-header {
    margin: 0;
    color: var(--fg);
    font: 900 clamp(40px, 6vw, 72px)/1.1 var(--f-cn-display);
    letter-spacing: .04em;
  }

  /* One page head everywhere, like the home sections: a Chinese title, an
     English italic subtitle, then one plain line. */
  .page .post-title .post-title-sub,
  .archive-page-header h1 small {
    display: block;
    margin-top: 10px;
    color: var(--mute);
    font: italic 500 22px var(--f-poem);
    letter-spacing: 0;
  }

  .main-inner.page .post-header .post-description,
  .archive-page-header p {
    max-width: none;
    margin: 18px 0 0;
    padding: 0;
    border: 0;
    color: var(--mute);
    font: 15px/1.7 var(--f-body);
  }

  /* NexT prints 分类 / 标签 here. Chinese is never set in italic, so the
     visible subtitle is the English word, in the poem italic. */
  .posts-collapse .collection-title .collection-header small {
    display: block;
    margin-top: 10px;
    color: var(--mute);
    font-size: 0;
    letter-spacing: 0;
  }

  .posts-collapse .collection-title .collection-header small::after {
    font: italic 500 22px var(--f-poem);
  }

  .category .collection-title .collection-header small::after {
    content: "realm";
  }

  .tag .collection-title .collection-header small::after {
    content: "tag";
  }

  /* ───── Category / tag post lists ───── */
  .posts-collapse .post-content {
    margin-left: 0;
    padding-left: 0;
    border-left: 0;
  }

  .posts-collapse .post-content::before {
    display: none;
  }

  .posts-collapse .post-content .collection-year {
    margin: 36px 0 0;
    padding: 0 0 10px;
    border-bottom: 1px solid var(--line);
  }

  .posts-collapse .post-content .collection-year::before {
    display: none;
  }

  .posts-collapse .post-content .collection-year .collection-header {
    color: var(--cyan);
    font: 12px var(--f-mono);
    letter-spacing: .2em;
  }

  .posts-collapse .post-content .post-header {
    display: grid;
    grid-template-columns: 70px minmax(0, 1fr);
    align-items: baseline;
    gap: 16px;
    margin: 0;
    padding: 16px 4px;
    border-bottom: 1px solid var(--line);
  }

  .posts-collapse .post-content .post-header::before {
    display: none;
  }

  .posts-collapse .post-content .post-meta-container {
    color: var(--mute);
    font: 12px var(--f-mono);
  }

  .posts-collapse .post-content .post-title {
    margin: 0;
    font: 700 18px/1.5 var(--f-cn-display);
  }

  .posts-collapse .post-content .post-title a {
    border: 0;
    color: var(--fg);
  }

  .posts-collapse .post-content .post-title a:hover {
    color: #fff;
  }

  .posts-collapse .post-content .post-title a::before {
    display: none;
  }

  /* ───── Tag cloud & category list ───── */
  .tag-cloud,
  .category-all-page {
    text-align: left;
  }

  /* NexT centres this line and draws the count as a badge; match the
     tag page instead. */
  .tag-cloud-title,
  .category-all-page .category-all-title {
    margin-bottom: 18px;
    color: var(--mute);
    font: 12px var(--f-mono);
    letter-spacing: .1em;
    text-align: left;
  }

  .tag-cloud-tags {
    text-align: left;
  }

  .tag-cloud-tags a {
    display: inline-block;
    margin: 6px 14px 6px 0;
    border: 0;
    color: var(--violet);
    font-family: var(--f-mono);
  }

  .tag-cloud-tags a::before {
    content: "#";
    color: var(--mute);
  }

  .tag-cloud-tags a:hover {
    color: #fff;
  }

  .category-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .category-list-item {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin: 0;
    padding: 18px 4px;
    border-bottom: 1px solid var(--line);
  }

  .category-all-page .category-list-link {
    border: 0;
    color: var(--fg);
    font: 900 40px/1 var(--f-display);
    letter-spacing: .03em;
  }

  .category-all-page .category-list-item {
    margin: 0;
  }

  .category-all-page .category-list-count {
    padding: 0;
    border-radius: 0;
    background: none;
    color: var(--cyan);
    font: 12px var(--f-mono);
  }

  .category-list-count::before {
    content: "ENTRIES ";
    color: var(--mute);
  }

  .category-list-child {
    padding-left: 20px;
  }

  /* ───── Archive tree (themes/next/layout/archive.njk) ───── */
  .archive-accordion .archive-block {
    padding: 0;
  }

  .archive-page-header {
    margin-bottom: 40px;
    text-align: left;
  }

  .archive-page-header h1 {
    margin: 8px 0 10px;
    color: var(--fg);
    font: 900 clamp(40px, 6vw, 72px)/1.1 var(--f-cn-display);
    letter-spacing: .04em;
  }

  /* Years and months are plain rules over one list, like the category
     pages; no boxes inside boxes. */
  .archive-tree {
    display: grid;
    gap: 8px;
  }

  .archive-year,
  .archive-month {
    overflow: hidden;
    border: 0;
    background: none;
  }

  .archive-year > summary,
  .archive-month > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: var(--cursor-pointer, pointer);
    list-style: none;
  }

  .archive-year > summary::-webkit-details-marker,
  .archive-month > summary::-webkit-details-marker {
    display: none;
  }

  /* A chevron that turns down when open; a rotated + read as "close". */
  .archive-year > summary::after,
  .archive-month > summary::after {
    content: "\203A";
    width: 20px;
    margin-left: 12px;
    color: var(--mute);
    font: 18px/1 var(--f-mono);
    text-align: center;
    transition: transform .2s ease;
  }

  .archive-year[open] > summary::after,
  .archive-month[open] > summary::after {
    transform: rotate(90deg);
  }

  .archive-year > summary {
    padding: 16px 4px 12px;
    border-bottom: 1px solid var(--line);
  }

  .archive-year-name {
    margin-right: auto;
    color: var(--fg);
    font: 900 34px/1 var(--f-display);
  }

  .archive-panel-count {
    color: var(--mute);
    font: 12px var(--f-mono);
  }

  .archive-months {
    display: grid;
    gap: 0;
    padding: 0;
  }

  .archive-month > summary {
    padding: 14px 4px 8px;
  }

  .archive-month-name {
    margin-right: auto;
    color: var(--text);
    font: 12px var(--f-mono);
    letter-spacing: .1em;
  }

  .archive-post-list {
    margin: 0;
    padding: 0 0 8px;
    list-style: none;
  }

  .archive-post-list li {
    display: grid;
    grid-template-columns: 58px minmax(0, 1fr);
    align-items: baseline;
    gap: 12px;
    padding: 10px 4px;
    border-top: 1px solid var(--line);
  }

  .archive-post-list time {
    color: var(--mute);
    font: 12px var(--f-mono);
    font-variant-numeric: tabular-nums;
  }

  .archive-post-list a {
    overflow: hidden;
    border: 0;
    color: var(--fg);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .archive-post-list a:hover {
    color: var(--cyan);
  }

  /* ───── Learning paths ───── */
  .learning-paths-intro {
    margin: 0 0 28px;
  }

  .learning-paths-intro p {
    display: none;
  }

  .learning-paths-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    color: var(--mute);
    font: 12px var(--f-mono);
  }

  .learning-paths-stats strong {
    color: var(--cyan);
    font-weight: 400;
  }

  .learning-path-grid {
    display: grid;
    gap: 28px;
  }

  .learning-path-card {
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--ink);
  }

  .learning-path-card-header {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 18px 20px;
    border-bottom: 1px solid var(--line);
  }

  .learning-path-card-header h2 {
    margin: 0;
    padding: 0;
    border: 0;
    color: var(--fg);
    font: 700 22px/1.3 var(--f-cn-display);
  }

  .learning-path-card-index {
    color: var(--cyan);
    font: 12px var(--f-mono);
    letter-spacing: .14em;
  }

  .learning-path-card-count {
    color: var(--mute);
    font: 12px var(--f-mono);
  }

  .learning-path-card .route-graph {
    border-width: 0 0 1px;
  }

  .learning-path-steps {
    margin: 0;
    padding: 6px 20px 14px;
    list-style: none;
  }

  .learning-path-step {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr);
    gap: 10px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
  }

  .learning-path-step:last-child {
    border-bottom: 0;
  }

  .learning-path-step-number {
    color: var(--cyan);
    font: 12px/1.9 var(--f-mono);
  }

  .learning-path-step-number::before {
    content: "#";
    color: var(--mute);
  }

  .learning-path-step-title {
    border: 0;
    color: var(--fg);
    font-weight: 500;
  }

  .learning-path-step-title:hover {
    color: var(--cyan);
  }

  .learning-path-step-date {
    display: block;
    color: var(--mute);
    font: 11px var(--f-mono);
  }

  .learning-path-step-description {
    margin: 4px 0 0;
    color: var(--mute);
    font-size: 14px;
    line-height: 1.7;
  }

  .learning-paths-empty {
    padding: 28px 0;
    color: var(--mute);
  }

  /* ───── 404 (source/404.md) ───── */
  .not-found-page {
    max-width: 640px;
    margin: 20px 0;
    text-align: left;
  }

  .not-found-code {
    display: block;
    color: transparent;
    font: 900 clamp(110px, 24vw, 220px)/.85 var(--f-display);
    -webkit-text-stroke: 1px var(--line-2);
  }

  .not-found-page h2 {
    margin: 18px 0 12px;
    color: var(--fg);
    font: 900 clamp(30px, 4vw, 44px)/1.25 var(--f-cn-display);
  }

  .not-found-page p {
    color: var(--mute);
    line-height: 1.8;
  }

  .not-found-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 26px;
  }

  .not-found-actions button,
  .not-found-actions a {
    display: inline-flex;
    min-height: 44px;
    box-sizing: border-box;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border: 1px solid var(--line-2) !important;
    border-radius: 2px;
    background: none;
    color: var(--fg) !important;
    font: 13px var(--f-mono);
    cursor: var(--cursor-pointer, pointer);
  }

  .not-found-actions button {
    border-color: var(--fg) !important;
    background: var(--fg);
    color: var(--void) !important;
  }

  .not-found-actions a:hover {
    border-color: var(--cyan) !important;
  }

  @media (max-width: 767px) {
    .posts-collapse .post-content .post-header {
      grid-template-columns: 52px minmax(0, 1fr);
      gap: 10px;
    }

    .archive-post-list li {
      grid-template-columns: 48px minmax(0, 1fr);
      gap: 8px;
    }

    .not-found-actions {
      display: grid;
    }
  }

  /* ───── 暗室 ───── */
  .diary-intro {
    color: var(--mute);
  }

  .diary-feed {
    margin-top: 32px;
  }

  .diary-entry {
    padding: 24px 0 28px;
    border-top: 1px solid var(--line);
  }

  .diary-row {
    display: flex;
    gap: 20px;
    align-items: baseline;
    margin-bottom: 12px;
  }

  .diary-body > :last-child {
    margin-bottom: 0;
  }

  .diary-addr,
  .diary-row time {
    color: var(--mute);
    font: 12px var(--f-mono);
  }

  .diary-addr {
    color: var(--violet);
  }

  .diary-empty {
    margin-top: 48px;
    color: var(--mute);
    font: 12px var(--f-mono);
  }

  /* ───── Friends (scripts/signal-friends.js) ───── */
  .post-body .friend-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .friend-grid li {
    margin: 0;
  }

  .post-body .friend-card {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 16px;
    height: 100%;
    box-sizing: border-box;
    padding: 18px 20px;
    border: 1px solid var(--line);
    background: var(--ink);
    color: var(--text);
    transition: border-color .2s, background .2s;
  }

  .post-body .friend-card:hover {
    border-color: var(--cyan);
    background: var(--ink-2);
  }

  .friend-avatar {
    flex: none;
    width: 52px;
    height: 52px;
    margin: 0;
    border: 1px solid var(--line-2);
    object-fit: cover;
  }

  .friend-avatar-letter {
    display: grid;
    place-items: center;
    background: var(--ink-2);
    color: var(--cyan);
    font: 700 26px/1 var(--f-display);
  }

  .friend-grid li:nth-child(even) .friend-avatar-letter {
    color: var(--violet);
  }

  .friend-body {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
    padding-right: 28px;
  }

  .friend-name {
    color: var(--fg);
    font: 700 18px/1.4 var(--f-cn-display);
  }

  .friend-card:hover .friend-name {
    color: #fff;
  }

  .friend-host {
    overflow: hidden;
    color: var(--mute);
    font: 12px var(--f-mono);
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color .2s;
  }

  .friend-card:hover .friend-host {
    color: var(--cyan);
  }

  .friend-description {
    margin-top: 4px;
    color: var(--mute);
    font-size: 14px;
    line-height: 1.7;
  }

  .friend-loc {
    position: absolute;
    top: 12px;
    right: 14px;
    color: #4b5372;
    font: 11px var(--f-mono);
    letter-spacing: .1em;
  }

  .friends-empty {
    padding: 28px 0;
    color: var(--mute);
  }

  .friends-self {
    margin-top: 64px;
  }

  .post-body .friends-self h2 {
    margin: 0 0 14px;
    padding: 0;
    border: 0;
    color: var(--fg);
    font: 700 26px/1.3 var(--f-cn-display);
  }

  .post-body .friends-self h2::before {
    display: none;
  }

  .friends-self h2 small {
    display: block;
    margin-top: 6px;
    color: var(--mute);
    font: italic 500 18px var(--f-poem);
  }

  .friends-self p {
    color: var(--mute);
    font-size: 15px;
  }

  .friends-self-card {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: 8px 20px;
    margin: 18px 0 0;
    padding: 18px 20px;
    border: 1px solid var(--line);
    background: var(--ink);
    font: 13px/1.7 var(--f-mono);
  }

  .friends-self-card dt {
    color: var(--violet);
    font-weight: 400;
  }

  .friends-self-card dt::after {
    content: ":";
    color: var(--mute);
  }

  .friends-self-card dd {
    margin: 0;
    color: var(--fg);
    overflow-wrap: anywhere;
  }

  /* ───── Wander (scripts/signal-links.js) ───── */
  .post-body .wander-list {
    margin: 8px 0 0;
    border-top: 1px solid var(--line);
    padding: 0;
    list-style: none;
  }

  .wander-list li {
    margin: 0;
    border-bottom: 1px solid var(--line);
  }

  .post-body .wander-site {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 4px 20px;
    align-items: baseline;
    padding: 16px 4px;
    border: 0;
    color: var(--text);
  }

  .wander-name {
    color: var(--fg);
    font-weight: 500;
    transition: color .2s;
  }

  .wander-site:hover .wander-name {
    color: var(--cyan);
  }

  .wander-host {
    color: var(--mute);
    font: 12px var(--f-mono);
    text-align: right;
  }

  .wander-description {
    grid-column: 1 / -1;
    color: var(--mute);
    font-size: 14px;
    line-height: 1.7;
  }

  @media (max-width: 567px) {
    .post-body .wander-site {
      grid-template-columns: minmax(0, 1fr);
    }

    .wander-host {
      text-align: left;
    }
  }
}
