// SIGNAL secondary pages: archive tree, category/tag lists, tag cloud,
// learning paths and the 404 page.
@css {
  .page .post-header,
  .posts-collapse .collection-title {
    margin-bottom: 40px;
    text-align: left;
  }

  .collection-title {
    padding: 0;
    border: 0;
  }

  .collection-title::before {
    display: none;
  }

  .page .post-title,
  .posts-collapse .collection-title .collection-header {
    margin: 0;
    color: var(--fg);
    font: 900 clamp(40px, 6vw, 72px)/1.1 var(--f-cn-display);
    letter-spacing: .04em;
  }

  /* One page head everywhere, like the home sections: a Chinese title, an
     English italic subtitle, then one plain line. */
  .page .post-title .post-title-sub,
  .archive-page-header h1 small {
    display: block;
    margin-top: 10px;
    color: var(--mute);
    font: italic 500 22px var(--f-poem);
    letter-spacing: 0;
  }

  .main-inner.page .post-header .post-description,
  .archive-page-header p {
    max-width: none;
    margin: 18px 0 0;
    padding: 0;
    border: 0;
    color: var(--mute);
    font: 15px/1.7 var(--f-body);
  }

  /* NexT prints 分类 / 标签 here. Chinese is never set in italic, so the
     visible subtitle is the English word, in the poem italic. */
  .posts-collapse .collection-title .collection-header small {
    display: block;
    margin-top: 10px;
    color: var(--mute);
    font-size: 0;
    letter-spacing: 0;
  }

  .posts-collapse .collection-title .collection-header small::after {
    font: italic 500 22px var(--f-poem);
  }

  .category .collection-title .collection-header small::after {
    content: "realm";
  }

  .tag .collection-title .collection-header small::after {
    content: "tag";
  }

  /* ───── Category / tag post lists ───── */
  .posts-collapse .post-content {
    margin-left: 0;
    padding-left: 0;
    border-left: 0;
  }

  .posts-collapse .post-content::before {
    display: none;
  }

  .posts-collapse .post-content .collection-year {
    margin: 36px 0 0;
    padding: 0 0 10px;
    border-bottom: 1px solid var(--line);
  }

  .posts-collapse .post-content .collection-year::before {
    display: none;
  }

  .posts-collapse .post-content .collection-year .collection-header {
    color: var(--cyan);
    font: 12px var(--f-mono);
    letter-spacing: .2em;
  }

  .posts-collapse .post-content .post-header {
    display: grid;
    grid-template-columns: 70px minmax(0, 1fr);
    align-items: baseline;
    gap: 16px;
    margin: 0;
    padding: 16px 4px;
    border-bottom: 1px solid var(--line);
  }

  .posts-collapse .post-content .post-header::before {
    display: none;
  }

  .posts-collapse .post-content .post-meta-container {
    color: var(--mute);
    font: 12px var(--f-mono);
  }

  .posts-collapse .post-content .post-title {
    margin: 0;
    font: 700 18px/1.5 var(--f-cn-display);
  }

  .posts-collapse .post-content .post-title a {
    border: 0;
    color: var(--fg);
  }

  .posts-collapse .post-content .post-title a:hover {
    color: #fff;
  }

  .posts-collapse .post-content .post-title a::before {
    display: none;
  }

  /* ───── Tag cloud & category list ───── */
  .tag-cloud,
  .category-all-page {
    text-align: left;
  }

  /* NexT centres this line and draws the count as a badge; match the
     tag page instead. */
  .tag-cloud-title,
  .category-all-page .category-all-title {
    margin-bottom: 18px;
    color: var(--mute);
    font: 12px var(--f-mono);
    letter-spacing: .1em;
    text-align: left;
  }

  .tag-cloud-tags {
    text-align: left;
  }

  .tag-cloud-tags a {
    display: inline-block;
    margin: 6px 14px 6px 0;
    border: 0;
    color: var(--violet);
    font-family: var(--f-mono);
  }

  .tag-cloud-tags a::before {
    content: "#";
    color: var(--mute);
  }

  .tag-cloud-tags a:hover {
    color: #fff;
  }

  .category-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .category-list-item {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin: 0;
    padding: 18px 4px;
    border-bottom: 1px solid var(--line);
  }

  .category-all-page .category-list-link {
    border: 0;
    color: var(--fg);
    font: 900 40px/1 var(--f-display);
    letter-spacing: .03em;
  }

  .category-all-page .category-list-item {
    margin: 0;
  }

  .category-all-page .category-list-count {
    padding: 0;
    border-radius: 0;
    background: none;
    color: var(--cyan);
    font: 12px var(--f-mono);
  }

  .category-list-count::before {
    content: "ENTRIES ";
    color: var(--mute);
  }

  .category-list-child {
    padding-left: 20px;
  }

  /* ───── Archive tree (themes/next/layout/archive.njk) ───── */
  .archive-accordion .archive-block {
    padding: 0;
  }

  .archive-page-header {
    margin-bottom: 40px;
    text-align: left;
  }

  .archive-page-header h1 {
    margin: 8px 0 10px;
    color: var(--fg);
    font: 900 clamp(40px, 6vw, 72px)/1.1 var(--f-cn-display);
    letter-spacing: .04em;
  }

  /* Years and months are plain rules over one list, like the category
     pages; no boxes inside boxes. */
  .archive-tree {
    display: grid;
    gap: 8px;
  }

  .archive-year,
  .archive-month {
    overflow: hidden;
    border: 0;
    background: none;
  }

  .archive-year > summary,
  .archive-month > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: var(--cursor-pointer, pointer);
    list-style: none;
  }

  .archive-year > summary::-webkit-details-marker,
  .archive-month > summary::-webkit-details-marker {
    display: none;
  }

  /* A chevron that turns down when open; a rotated + read as "close". */
  .archive-year > summary::after,
  .archive-month > summary::after {
    content: "\203A";
    width: 20px;
    margin-left: 12px;
    color: var(--mute);
    font: 18px/1 var(--f-mono);
    text-align: center;
    transition: transform .2s ease;
  }

  .archive-year[open] > summary::after,
  .archive-month[open] > summary::after {
    transform: rotate(90deg);
  }

  .archive-year > summary {
    padding: 16px 4px 12px;
    border-bottom: 1px solid var(--line);
  }

  .archive-year-name {
    margin-right: auto;
    color: var(--fg);
    font: 900 34px/1 var(--f-display);
  }

  .archive-panel-count {
    color: var(--mute);
    font: 12px var(--f-mono);
  }

  .archive-months {
    display: grid;
    gap: 0;
    padding: 0;
  }

  .archive-month > summary {
    padding: 14px 4px 8px;
  }

  .archive-month-name {
    margin-right: auto;
    color: var(--text);
    font: 12px var(--f-mono);
    letter-spacing: .1em;
  }

  .archive-post-list {
    margin: 0;
    padding: 0 0 8px;
    list-style: none;
  }

  .archive-post-list li {
    display: grid;
    grid-template-columns: 58px minmax(0, 1fr);
    align-items: baseline;
    gap: 12px;
    padding: 10px 4px;
    border-top: 1px solid var(--line);
  }

  .archive-post-list time {
    color: var(--mute);
    font: 12px var(--f-mono);
    font-variant-numeric: tabular-nums;
  }

  .archive-post-list a {
    overflow: hidden;
    border: 0;
    color: var(--fg);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .archive-post-list a:hover {
    color: var(--cyan);
  }

  /* ───── Learning paths ───── */
  .learning-paths-intro {
    margin: 0 0 28px;
  }

  .learning-paths-intro p {
    display: none;
  }

  .learning-paths-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    color: var(--mute);
    font: 12px var(--f-mono);
  }

  .learning-paths-stats strong {
    color: var(--cyan);
    font-weight: 400;
  }

  .learning-path-grid {
    display: grid;
    gap: 28px;
  }

  .learning-path-card {
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--ink);
  }

  .learning-path-card-header {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 18px 20px;
    border-bottom: 1px solid var(--line);
  }

  .learning-path-card-header h2 {
    margin: 0;
    padding: 0;
    border: 0;
    color: var(--fg);
    font: 700 22px/1.3 var(--f-cn-display);
  }

  .learning-path-card-index {
    color: var(--cyan);
    font: 12px var(--f-mono);
    letter-spacing: .14em;
  }

  .learning-path-card-count {
    color: var(--mute);
    font: 12px var(--f-mono);
  }

  .learning-path-card .route-graph {
    border-width: 0 0 1px;
  }

  .learning-path-steps {
    margin: 0;
    padding: 6px 20px 14px;
    list-style: none;
  }

  .learning-path-step {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr);
    gap: 10px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
  }

  .learning-path-step:last-child {
    border-bottom: 0;
  }

  .learning-path-step-number {
    color: var(--cyan);
    font: 12px/1.9 var(--f-mono);
  }

  .learning-path-step-number::before {
    content: "#";
    color: var(--mute);
  }

  .learning-path-step-title {
    border: 0;
    color: var(--fg);
    font-weight: 500;
  }

  .learning-path-step-title:hover {
    color: var(--cyan);
  }

  .learning-path-step-date {
    display: block;
    color: var(--mute);
    font: 11px var(--f-mono);
  }

  .learning-path-step-description {
    margin: 4px 0 0;
    color: var(--mute);
    font-size: 14px;
    line-height: 1.7;
  }

  /* A long route shows its first steps until it is unfolded. */
  .learning-path-card.is-folded:not(.is-unfolded) .learning-path-step.is-beyond-fold {
    display: none;
  }

  .learning-path-toggle {
    display: block;
    width: 100%;
    padding: 12px 20px;
    border: 0;
    border-top: 1px solid var(--line);
    background: transparent;
    color: var(--cyan);
    font: 12px var(--f-mono);
    letter-spacing: .08em;
    text-align: left;
    cursor: pointer;
    transition: background .2s ease;
  }

  .learning-path-toggle:hover,
  .learning-path-toggle:focus-visible {
    background: var(--ink-2);
  }

  .learning-paths-empty {
    padding: 28px 0;
    color: var(--mute);
  }

  /* ───── 404 (source/404.md): the one page where the signal breaks ─────
     Red is reserved for this page: a crash, not a hint. */
  .main-inner.page:has(.not-found-page) .post-header {
    display: none;
  }

  .not-found-page {
    --nf-red: #ff2b4f;
    --nf-red-dim: rgba(255, 43, 79, .16);
    position: relative;
    max-width: 720px;
    margin: 0 0 20px;
    text-align: left;
  }

  /* The city loses its colour: the backdrop and moon turn red. */
  body:has(.not-found-page) .signal-backdrop {
    filter: hue-rotate(150deg) saturate(1.6) brightness(.9);
  }

  body:has(.not-found-page) .signal-moon {
    filter: sepia(1) hue-rotate(-50deg) saturate(4) brightness(.8) drop-shadow(0 0 24px rgba(255, 43, 79, .45));
  }

  body:has(.not-found-page)::after {
    content: "";
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      repeating-linear-gradient(0deg, rgba(255, 43, 79, .05) 0 1px, transparent 1px 4px),
      radial-gradient(ellipse at 50% 40%, transparent 45%, rgba(120, 0, 20, .35));
  }

  /* Caution tape across the full width. */
  .nf-tape {
    position: relative;
    width: var(--nf-w, 100vw);
    margin: 0 0 34px calc(-1 * var(--nf-x, 0px));
    overflow: hidden;
    padding: clamp(18px, 4vw, 40px) 0;
  }

  .nf-tape-band {
    width: 112vw;
    margin-left: -6vw;
    transform: rotate(-2.2deg);
    background: var(--nf-red);
    box-shadow: 0 0 40px rgba(255, 43, 79, .35);
  }

  .nf-tape-track {
    display: flex;
    width: max-content;
    color: var(--void);
    font: 800 15px/1 var(--f-mono);
    letter-spacing: .12em;
    white-space: nowrap;
  }

  .nf-tape-track span {
    padding: 9px 0;
    background: repeating-linear-gradient(-45deg, transparent 0 18px, rgba(0, 0, 0, .14) 18px 36px);
  }

  .nf-alert {
    margin: 0 0 6px !important;
    color: var(--mute) !important;
    font: 12px/1.6 var(--f-mono) !important;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .nf-alert b {
    margin-right: 10px;
    color: var(--nf-red);
    font-weight: 700;
  }

  /* 404, torn: red body, a cyan ghost, and a slice knocked sideways. */
  .nf-code {
    position: relative;
    display: inline-block;
    color: var(--nf-red);
    font: 900 clamp(130px, 30vw, 280px)/.82 var(--f-display);
    letter-spacing: -.01em;
    text-shadow: 0 0 34px rgba(255, 43, 79, .45);
    user-select: none;
  }

  .nf-code span {
    display: block;
    clip-path: polygon(0 0, 100% 0, 100% 44%, 0 44%, 0 56%, 100% 56%, 100% 100%, 0 100%);
  }

  .nf-code::before,
  .nf-code::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* the slice between 44% and 56%, pushed right */
  .nf-code::before {
    color: var(--nf-red);
    clip-path: inset(44% 0 44% 0);
    transform: translateX(.09em);
    text-shadow: -3px 0 var(--cyan);
  }

  .nf-code::after {
    color: transparent;
    -webkit-text-stroke: 1px var(--cyan);
    transform: translate(-.035em, .02em);
    opacity: .7;
    mix-blend-mode: screen;
  }

  .not-found-page h1 {
    margin: 26px 0 12px;
    color: var(--fg);
    font: 900 clamp(40px, 6vw, 68px)/1.15 var(--f-cn-display);
    letter-spacing: .04em;
    text-shadow: 2px 0 var(--nf-red), -2px 0 rgba(124, 236, 255, .55);
  }

  .not-found-page h1 small {
    display: block;
    margin-top: 10px;
    color: var(--nf-red);
    font: italic 500 22px var(--f-poem);
    letter-spacing: 0;
    text-shadow: none;
  }

  .not-found-page .nf-lead {
    color: var(--mute);
    line-height: 1.8;
  }

  .nf-dump {
    margin: 26px 0 0;
    padding: 16px 18px;
    overflow-x: auto;
    border: 1px solid var(--nf-red-dim);
    border-left: 3px solid var(--nf-red);
    border-radius: 0;
    background: rgba(20, 2, 8, .72);
    color: var(--text);
    font: 12.5px/1.75 var(--f-mono);
    white-space: pre;
  }

  .nf-dump b { color: var(--nf-red); font-weight: 700; }
  .nf-dump i { color: var(--heat); font-style: normal; }
  .nf-dump em { color: var(--cyan); font-style: normal; }
  .nf-dump .nf-dim { color: var(--mute); }

  .nf-caret {
    display: inline-block;
    width: .6em;
    height: 1.1em;
    vertical-align: -.2em;
    background: var(--nf-red);
  }

  .not-found-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 26px;
  }

  .not-found-actions button,
  .not-found-actions a {
    display: inline-flex;
    min-height: 44px;
    box-sizing: border-box;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border: 1px solid var(--line-2) !important;
    border-radius: 0;
    background: none;
    color: var(--fg) !important;
    font: 13px var(--f-mono);
    letter-spacing: .06em;
    cursor: var(--cursor-pointer, pointer);
    transition: transform .12s, box-shadow .12s, border-color .12s;
  }

  .not-found-actions button {
    border-color: var(--nf-red) !important;
    background: var(--nf-red);
    color: var(--void) !important;
    font-weight: 700;
    clip-path: polygon(0 0, calc(100% - 12px) 0, 100% 12px, 100% 100%, 12px 100%, 0 calc(100% - 12px));
  }

  .not-found-actions button:hover,
  .not-found-actions button:focus-visible {
    transform: translate(-2px, -2px);
    box-shadow: 4px 4px 0 var(--cyan);
  }

  .not-found-actions a:hover,
  .not-found-actions a:focus-visible {
    border-color: var(--nf-red) !important;
    color: var(--nf-red) !important;
  }

  .signal-rip.is-fault,
  .signal-rip.is-fault b {
    color: #ff2b4f;
  }

  @media (prefers-reduced-motion: no-preference) {
    .nf-tape-track { animation: nf-tape 26s linear infinite; }
    .nf-code::before { animation: nf-slice 3.2s steps(1) infinite; }
    .nf-code span { animation: nf-jolt 3.2s steps(1) infinite; }
    .nf-caret { animation: nf-blink 1s steps(1) infinite; }
    body:has(.not-found-page) .signal-backdrop { animation: nf-flicker 5s steps(1) infinite; }
  }

  @keyframes nf-tape {
    to { transform: translateX(-50%); }
  }

  @keyframes nf-slice {
    0% { clip-path: inset(44% 0 44% 0); transform: translateX(.09em); }
    70% { clip-path: inset(18% 0 70% 0); transform: translateX(-.06em); }
    73% { clip-path: inset(62% 0 22% 0); transform: translateX(.14em); }
    76% { clip-path: inset(44% 0 44% 0); transform: translateX(.09em); }
    90% { clip-path: inset(80% 0 6% 0); transform: translateX(-.1em); }
    92% { clip-path: inset(44% 0 44% 0); transform: translateX(.09em); }
  }

  @keyframes nf-jolt {
    0%, 71%, 74%, 100% { transform: none; }
    72% { transform: translate(-4px, 1px) skewX(-6deg); }
    73% { transform: translate(5px, -1px); }
  }

  @keyframes nf-blink {
    50% { opacity: 0; }
  }

  @keyframes nf-flicker {
    0%, 100% { opacity: 1; }
    61% { opacity: .55; }
    62% { opacity: 1; }
    64% { opacity: .35; }
    65% { opacity: 1; }
  }

  @media (max-width: 767px) {
    .posts-collapse .post-content .post-header {
      grid-template-columns: 52px minmax(0, 1fr);
      gap: 10px;
    }

    .archive-post-list li {
      grid-template-columns: 48px minmax(0, 1fr);
      gap: 8px;
    }

    .not-found-actions {
      display: grid;
    }

    .nf-dump {
      font-size: 11px;
    }

    .nf-alert {
      letter-spacing: .06em;
      font-size: 11px !important;
    }
  }

  /* ───── 暗室 ───── */
  .diary-intro {
    color: var(--mute);
  }

  .diary-feed {
    margin-top: 32px;
  }

  .diary-entry {
    padding: 24px 0 28px;
    border-top: 1px solid var(--line);
  }

  .diary-row {
    display: flex;
    gap: 20px;
    align-items: baseline;
    margin-bottom: 12px;
  }

  .diary-body > :last-child {
    margin-bottom: 0;
  }

  .diary-addr,
  .diary-row time {
    color: var(--mute);
    font: 12px var(--f-mono);
  }

  .diary-addr {
    color: var(--violet);
  }

  .diary-empty {
    margin-top: 48px;
    color: var(--mute);
    font: 12px var(--f-mono);
  }

  /* ───── Friends (scripts/signal-friends.js) ───── */
  .post-body .friend-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .friend-grid li {
    margin: 0;
  }

  .post-body .friend-card {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 16px;
    height: 100%;
    box-sizing: border-box;
    padding: 18px 20px;
    border: 1px solid var(--line);
    background: var(--ink);
    color: var(--text);
    transition: border-color .2s, background .2s;
  }

  .post-body .friend-card:hover {
    border-color: var(--cyan);
    background: var(--ink-2);
  }

  .friend-avatar {
    flex: none;
    width: 52px;
    height: 52px;
    margin: 0;
    border: 1px solid var(--line-2);
    object-fit: cover;
  }

  .friend-avatar-letter {
    display: grid;
    place-items: center;
    background: var(--ink-2);
    color: var(--cyan);
    font: 700 26px/1 var(--f-display);
  }

  .friend-grid li:nth-child(even) .friend-avatar-letter {
    color: var(--violet);
  }

  .friend-body {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
    padding-right: 28px;
  }

  .friend-name {
    color: var(--fg);
    font: 700 18px/1.4 var(--f-cn-display);
  }

  .friend-card:hover .friend-name {
    color: #fff;
  }

  .friend-host {
    overflow: hidden;
    color: var(--mute);
    font: 12px var(--f-mono);
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color .2s;
  }

  .friend-card:hover .friend-host {
    color: var(--cyan);
  }

  .friend-description {
    margin-top: 4px;
    color: var(--mute);
    font-size: 14px;
    line-height: 1.7;
  }

  .friend-loc {
    position: absolute;
    top: 12px;
    right: 14px;
    color: #4b5372;
    font: 11px var(--f-mono);
    letter-spacing: .1em;
  }

  .friends-empty {
    padding: 28px 0;
    color: var(--mute);
  }

  .friends-self {
    margin-top: 64px;
  }

  .post-body .friends-self h2 {
    margin: 0 0 14px;
    padding: 0;
    border: 0;
    color: var(--fg);
    font: 700 26px/1.3 var(--f-cn-display);
  }

  .post-body .friends-self h2::before {
    display: none;
  }

  .friends-self h2 small {
    display: block;
    margin-top: 6px;
    color: var(--mute);
    font: italic 500 18px var(--f-poem);
  }

  .friends-self p {
    color: var(--mute);
    font-size: 15px;
  }

  .friends-self-card {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: 8px 20px;
    margin: 18px 0 0;
    padding: 18px 20px;
    border: 1px solid var(--line);
    background: var(--ink);
    font: 13px/1.7 var(--f-mono);
  }

  .friends-self-card dt {
    color: var(--violet);
    font-weight: 400;
  }

  .friends-self-card dt::after {
    content: ":";
    color: var(--mute);
  }

  .friends-self-card dd {
    margin: 0;
    color: var(--fg);
    overflow-wrap: anywhere;
  }

  /* ───── Wander (scripts/signal-links.js) ───── */
  .post-body .wander-list {
    margin: 8px 0 0;
    border-top: 1px solid var(--line);
    padding: 0;
    list-style: none;
  }

  .wander-list li {
    margin: 0;
    border-bottom: 1px solid var(--line);
  }

  .post-body .wander-site {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 4px 20px;
    align-items: baseline;
    padding: 16px 4px;
    border: 0;
    color: var(--text);
  }

  .wander-name {
    color: var(--fg);
    font-weight: 500;
    transition: color .2s;
  }

  .wander-site:hover .wander-name {
    color: var(--cyan);
  }

  .wander-host {
    color: var(--mute);
    font: 12px var(--f-mono);
    text-align: right;
  }

  .wander-description {
    grid-column: 1 / -1;
    color: var(--mute);
    font-size: 14px;
    line-height: 1.7;
  }

  @media (max-width: 567px) {
    .post-body .wander-site {
      grid-template-columns: minmax(0, 1fr);
    }

    .wander-host {
      text-align: left;
    }
  }
}
