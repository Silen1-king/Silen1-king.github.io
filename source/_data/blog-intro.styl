// Graphic intro (source/js/blog-intro.js). Plain CSS inside @css so Stylus
// leaves modern functions such as max() and env() untouched.
@css {
  html.blog-intro-pending {
    overflow: hidden;
  }

  html.blog-intro-pending .main,
  html.blog-intro-pending .footer {
    opacity: 0;
  }

  .blog-intro {
    position: fixed;
    inset: 0;
    z-index: 2147483647;
    overflow: hidden;
    background: #05060b;
    clip-path: inset(0 0 0 0);
    transition: clip-path .7s cubic-bezier(.8, 0, .2, 1);
    cursor: pointer;
  }

  .blog-intro[hidden] {
    display: none;
  }

  .blog-intro.is-leaving {
    clip-path: inset(50% 0 50% 0);
    pointer-events: none;
  }

  .blog-intro-canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .blog-intro-skip {
    position: absolute;
    right: max(24px, env(safe-area-inset-right, 0px));
    bottom: calc(env(safe-area-inset-bottom, 0px) + 22px);
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    padding: 0;
    border: 1px solid rgba(150, 170, 255, .26);
    border-radius: 50%;
    background: none;
    color: #7f88a3;
    cursor: pointer;
  }

  .blog-intro-skip:hover,
  .blog-intro-skip:focus-visible {
    border-color: #7cecff;
    color: #e7eaf4;
  }
}
