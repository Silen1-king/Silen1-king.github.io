// SIGNAL base: tokens, page shell, header, footer (Coda) and NexT widgets.
// Written as plain CSS inside @css: Stylus would otherwise rewrite min(),
// max() and clamp(), which this design relies on.
@css {
  /* Self-hosted Latin fonts (source/fonts/, latin subset, variable weight).
     Noto Serif SC for headings comes from /fonts/display.css, built by
     scripts/signal-fonts.js; body text uses the system Chinese font. */
  @font-face {
    font-family: "Big Shoulders Display";
    font-style: normal;
    font-weight: 100 900;
    font-display: swap;
    src: url("/fonts/big-shoulders-display.woff2") format("woff2");
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }

  @font-face {
    font-family: "Cormorant Garamond";
    font-style: italic;
    font-weight: 300 700;
    font-display: swap;
    src: url("/fonts/cormorant-garamond-italic.woff2") format("woff2");
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }

  @font-face {
    font-family: "JetBrains Mono";
    font-style: normal;
    font-weight: 100 800;
    font-display: swap;
    src: url("/fonts/jetbrains-mono.woff2") format("woff2");
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }

  :root {
    --void: #05060b;
    --ink: #0c0f19;
    --ink-2: #121626;
    --line: rgba(150, 170, 255, .13);
    --line-2: rgba(150, 170, 255, .26);
    --fg: #e7eaf4;
    --text: #cfd4e3;
    --mute: #7f88a3;
    --cyan: #7cecff;
    --violet: #a88bff;
    --heat: #ffb067;
    --green: #7dffb2;
    --rose: #ff7e9d;
    --f-display: "Big Shoulders Display", "Arial Narrow", Impact, sans-serif;
    --f-poem: "Cormorant Garamond", "Iowan Old Style", "Palatino Linotype", Georgia, serif;
    --f-cn-display: "Noto Serif SC", "Songti SC", "SimSun", serif;
    --f-body: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Noto Sans CJK SC", "Source Han Sans SC", sans-serif;
    --f-mono: "JetBrains Mono", ui-monospace, "Cascadia Code", Consolas, monospace;
    --gut: max(16px, env(safe-area-inset-left, 0px));
    --gutr: max(16px, env(safe-area-inset-right, 0px));
    --header-h: 60px;
    --header-top: env(safe-area-inset-top, 0px);
    --post-w: 760px;
    --page-w: 960px;
    /* Motion: one curve, two speeds. Hover and focus use --t-fast; things
       that appear or leave use --t-slow. */
    --ease: cubic-bezier(.2, .7, .2, 1);
    --t-fast: .2s;
    --t-slow: .6s;
    /* The signal line: the hero's wave, the rule under a title, the reading
       progress and the footer's edge are all this one stroke. */
    --signal-line: linear-gradient(90deg, rgba(124, 236, 255, 0), var(--cyan) 22%, var(--violet) 78%, rgba(168, 139, 255, 0));

    /* NexT's own palette, pointed at the SIGNAL tokens. */
    --body-bg-color: var(--void);
    --content-bg-color: var(--void);
    --card-bg-color: var(--ink);
    --text-color: var(--text);
    --blockquote-color: var(--mute);
    --link-color: var(--cyan);
    --link-hover-color: #fff;
    --brand-color: var(--fg);
    --brand-hover-color: #fff;
    --menu-item-bg-color: rgba(124, 236, 255, .06);
    --theme-color: var(--cyan);
    --selection-bg: var(--violet);
    --selection-color: var(--void);
    --table-row-odd-bg-color: rgba(150, 170, 255, .035);
    --table-row-hover-bg-color: rgba(124, 236, 255, .06);
    --btn-default-bg: transparent;
    --btn-default-color: var(--fg);
    --btn-default-border-color: var(--line-2);
    --btn-default-hover-bg: rgba(124, 236, 255, .06);
    --btn-default-hover-color: #fff;
    --btn-default-hover-border-color: var(--cyan);
    --highlight-background: #080a12;
    --highlight-foreground: #cfd4e3;
    --highlight-gutter-background: #080a12;
    --highlight-gutter-foreground: #3c4460;
    color-scheme: dark;
  }

  [hidden] {
    display: none !important;
  }

  html {
    scroll-behavior: smooth;
    scroll-padding-top: calc(var(--header-h) + var(--header-top) + 16px);
    background: var(--void);
  }

  body {
    min-height: 100vh;
    overflow-x: hidden;
    /* Transparent so the night under the page shows; html keeps the void. */
    background: transparent;
    color: var(--text);
    font-family: var(--f-body);
    font-size: 16px;
    line-height: 1.75;
    -webkit-font-smoothing: antialiased;
  }

  ::selection {
    background: var(--violet);
    color: var(--void);
  }

  :focus-visible {
    outline: 2px solid var(--cyan);
    outline-offset: 3px;
  }

  ::-webkit-scrollbar {
    width: 8px;
    height: 8px;
    background: var(--void);
  }

  ::-webkit-scrollbar-thumb {
    border-radius: 4px;
    background: var(--scrollbar-lit, rgba(150, 170, 255, .22));
  }

  ::-webkit-scrollbar-thumb:hover {
    background: var(--scrollbar-lit, rgba(150, 170, 255, .36));
  }

  /* signal-cursor.js hides the cursor on the page scrollbar and sets
     .signal-cursor-edge while the pointer is there; the thumb lights up.
     A variable, because Chrome won't restyle the page scrollbar from a
     class selector on html. */
  html.signal-cursor-edge {
    --scrollbar-lit: var(--cyan);
  }

  /* ───── Pointer ─────
     signal-cursor.js draws the cursor itself: a phosphor dot on a canvas.
     Before it has seen the mouse move, or if it never loads, the system
     cursor shows, redrawn to match (source/images/cursor/): a slim arrow,
     corner brackets that lock onto anything clickable, and an I-beam over
     text. Mouse only. Components that want the clickable cursor use
     var(--cursor-pointer, pointer), which falls back to the system hand
     everywhere else. */
  @media (hover: hover) and (pointer: fine) {
    :root {
      --cursor-default: url("/images/cursor/arrow.svg") 4 3, auto;
      --cursor-pointer: url("/images/cursor/lock.svg") 16 16, pointer;
      --cursor-text: url("/images/cursor/beam.svg") 16 16, text;
    }

    html {
      cursor: var(--cursor-default);
    }

    :is(p, li, dt, dd, td:not(.gutter), th, blockquote, figcaption, pre, code, kbd, h1, h2, h3, h4, h5, h6, input:not([type]), input[type="text"], input[type="search"], textarea) {
      cursor: var(--cursor-text);
    }

    /* Listed after the text rule, so a link inside a paragraph, or a heading
       inside a link, takes the clickable cursor. */
    :is(a, button:not(:disabled), [role="button"]:not(img), summary, label[for], select, input[type="checkbox"], input[type="radio"], input[type="submit"], .copy-btn),
    :is(a, button:not(:disabled), [role="button"]:not(img), summary, .copy-btn) *,
    .back-to-top.back-to-top-on {
      cursor: var(--cursor-pointer);
    }

    html.signal-cursor-on,
    html.signal-cursor-on * {
      cursor: none !important;
    }
  }

  .signal-cursor {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 2147483647;
    pointer-events: none;
  }

  @media print {
    .signal-cursor {
      display: none;
    }
  }

  .signal-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  /* ───── The night, and the moon ─────
     The page sits on a still night sky: the void, with a faint lift of
     blue at the top. Nothing in it moves.

     The moon appears twice, and nowhere else. On the home page it hangs
     beside the wordmark and fades as the hero scrolls away
     (.signal-past-hero, signal.js); that is this fixed image. At the end
     of a post it sits where the signal line comes to rest
     (signal-article.styl). 404 and 暗室 tint it their own colour
     (signal-pages.styl). */
  body::before {
    content: "";
    position: fixed;
    inset: 0;
    z-index: -3;
    background: radial-gradient(120% 70% at 78% -12%, #0e1224 0%, rgba(9, 11, 21, .6) 45%, rgba(5, 6, 11, 0) 75%);
    pointer-events: none;
  }

  :root {
    --moon-w: 120px;
    --moon-top: calc(var(--header-h) + var(--header-top) + 24px);
    --moon-right: max(16px, 2vw);
  }

  .signal-moon {
    position: fixed;
    top: var(--moon-top);
    right: var(--moon-right);
    z-index: -2;
    width: var(--moon-w);
    height: auto;
    opacity: 0;
    pointer-events: none;
    user-select: none;
    transition: opacity var(--t-slow) var(--ease);
  }

  /* Home: sized to the margin the wordmark leaves, so it never covers the 1. */
  :root:has(#signal-hero) {
    --moon-w: min(240px, 15vw);
    --moon-top: 38vh;
    --moon-right: 2vw;
  }

  :root:has(#signal-hero):not(.signal-past-hero):not(.blog-intro-pending) .signal-moon {
    opacity: .62;
    filter: saturate(.7) contrast(.86) brightness(.86) drop-shadow(0 0 18px rgba(124, 236, 255, .16));
  }

  @media (max-width: 767px) {
    :root {
      --moon-w: 84px;
      --moon-top: calc(var(--header-h) + var(--header-top) + 6px);
      --moon-right: 4px;
    }

    :root:has(#signal-hero) {
      --moon-w: 150px;
      --moon-top: 57svh;
      --moon-right: 4vw;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .signal-moon {
      transition: none;
    }
  }

  @media print {
    .signal-moon {
      display: none;
    }
  }

  /* ───── Header: a thin instrument bar ───── */
  .headband {
    display: none;
  }

  .column {
    background: none;
  }

  header.header {
    position: fixed;
    top: 0;
    right: 0;
    left: 0;
    z-index: 50;
    display: flex;
    width: auto;
    max-width: none;
    min-height: var(--header-h);
    box-sizing: border-box;
    align-items: center;
    gap: 20px;
    margin: 0;
    padding: var(--header-top) var(--gutr) 0 var(--gut);
    border-bottom: 1px solid transparent;
    background: linear-gradient(to bottom, rgba(5, 6, 11, .85), rgba(5, 6, 11, 0));
    font: 12px var(--f-mono);
    letter-spacing: .08em;
    transition: background var(--t-fast) var(--ease), border-color var(--t-fast) var(--ease), left var(--t-fast) var(--ease);
  }

  header.header.is-scrolled,
  .site-nav-on header.header {
    border-bottom-color: var(--line);
    background: rgba(5, 6, 11, .9);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }

  .site-brand-container {
    display: contents;
  }

  .site-meta {
    order: 1;
    flex: none;
    text-align: left;
  }

  .site-meta .brand {
    display: block;
    padding: 0;
    color: var(--fg);
  }

  .logo-line,
  .site-subtitle {
    display: none !important;
  }

  .site-title {
    font: 900 22px/1 var(--f-display);
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  .site-title em {
    color: var(--cyan);
    font-style: normal;
  }

  .site-nav {
    order: 2;
    flex: none;
  }

  .main-menu {
    display: flex;
    gap: 18px;
    margin: 0 0 0 12px;
    padding: 0;
  }

  .main-menu .menu-item {
    display: block;
    margin: 0;
  }

  .main-menu .menu-item a {
    position: relative;
    display: block;
    padding: 6px 2px;
    border: 0;
    background: none !important;
    color: var(--mute);
    font: 13px var(--f-body);
    letter-spacing: .14em;
    transition: color var(--t-fast) var(--ease);
  }

  .main-menu .menu-item a:hover,
  .main-menu .menu-item a[aria-current] {
    color: var(--fg);
  }

  .main-menu .menu-item a[aria-current]::after {
    content: "";
    position: absolute;
    right: 2px;
    bottom: 0;
    left: 2px;
    height: 1px;
    background: var(--cyan);
  }

  .site-nav-right {
    order: 3;
    display: flex;
    /* NexT stacks this column on phones; the header keeps it in a row. */
    flex-direction: row;
    align-items: center;
    gap: 18px;
    margin-left: auto;
  }

  .site-nav-toggle {
    order: 4;
    display: none;
  }

  .site-nav-toggle .toggle {
    box-sizing: content-box;
    width: 20px;
    padding: 12px 0 12px 12px;
    border: 0;
    background: none;
    cursor: var(--cursor-pointer, pointer);
  }

  .site-nav-toggle .toggle .toggle-line {
    background: var(--fg);
  }

  .global-search-trigger {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 12px;
    border: 1px solid var(--line-2);
    border-radius: 3px;
    background: rgba(255, 255, 255, .03);
    color: var(--fg);
    font: 12px var(--f-mono);
    letter-spacing: .08em;
    cursor: var(--cursor-pointer, pointer);
    transition: border-color var(--t-fast) var(--ease);
  }

  .global-search-trigger:hover,
  .global-search-trigger:focus-visible {
    border-color: var(--cyan);
  }

  .global-search-trigger > i {
    display: none;
  }

  /* The reader's language switch (signal-translate.js). Lit while on. */
  .signal-header-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-width: 32px;
    min-height: 32px;
    justify-content: center;
    padding: 0 8px;
    border: 1px solid transparent;
    border-radius: 3px;
    background: none;
    color: var(--mute);
    font: 11px var(--f-mono);
    letter-spacing: .14em;
    cursor: var(--cursor-pointer, pointer);
    transition: color var(--t-fast) var(--ease), border-color var(--t-fast) var(--ease);
  }

  .signal-header-btn:hover,
  .signal-header-btn:focus-visible {
    border-color: var(--line-2);
    color: var(--fg);
  }

  .signal-header-btn[aria-pressed="true"] {
    color: var(--cyan);
    text-shadow: 0 0 8px rgba(124, 236, 255, .5);
  }

  .signal-header-btn[aria-pressed="true"] svg {
    filter: drop-shadow(0 0 4px rgba(124, 236, 255, .6));
  }

  @media (max-width: 767px) {
    .site-nav-right {
      gap: 6px;
    }

  }

  .global-search-trigger kbd {
    padding: 1px 5px;
    border: 1px solid var(--line-2);
    border-radius: 2px;
    background: none;
    color: var(--mute);
    font: 11px var(--f-mono);
    box-shadow: none;
  }

  @media (max-width: 767px) {
    .site-nav-toggle {
      display: block;
    }

    .global-search-trigger kbd {
      display: none;
    }

    .site-nav {
      position: absolute;
      top: 100%;
      right: 0;
      left: 0;
      height: auto;
      max-height: 0;
      overflow: hidden;
      visibility: hidden;
      border-bottom: 1px solid transparent;
      background: rgba(5, 6, 11, .96);
      transition: max-height var(--t-fast) var(--ease), visibility var(--t-fast) var(--ease);
    }

    body.site-nav-on .site-nav {
      height: auto;
      max-height: 320px;
      visibility: visible;
      border-bottom-color: var(--line);
    }

    .main-menu {
      flex-direction: column;
      gap: 0;
      margin: 0;
      padding: 6px var(--gutr) 14px var(--gut);
    }

    .main-menu .menu-item a {
      padding: 12px 0;
      font-size: 15px;
    }
  }

  /* ───── Page shell ───── */
  /* Sticky footer in CSS. NexT's JS pins a short page's footer to the
     viewport bottom (.footer-fixed, position: absolute) but only rechecks on
     scroll/resize, so a page that grows later (an archive month opened, fonts
     or counters settling) left the footer drawn over the post list. The body
     column now pushes the footer down instead, and the class does nothing. */
  body {
    display: flex;
    flex-direction: column;
  }

  .main {
    flex: 1 0 auto;
    padding-bottom: 0;
  }

  .footer.footer-fixed {
    position: relative;
  }

  .main-inner {
    width: auto;
    max-width: var(--page-w);
    box-sizing: border-box;
    margin: 0 auto;
    padding: calc(var(--header-h) + var(--header-top) + 56px) var(--gutr) 80px var(--gut);
  }

  .main-inner.signal-index {
    max-width: none;
    padding: 0;
  }

  /* Mist resets .main-inner padding with !important on phones; keep pages clear of the fixed header. */
  @media (max-width: 567px) {
    .main-inner {
      padding-top: calc(var(--header-h) + var(--header-top) + 36px) !important;
    }

    .main-inner.signal-index {
      padding-top: 0 !important;
    }
  }

  .post-block:first-of-type {
    padding-top: 0;
  }

  .main-inner > .post-block,
  .posts-expand .post-block {
    padding: 0;
    border: 0;
    border-radius: 0;
    background: none;
    box-shadow: none;
  }

  /* ───── Footer: Coda ─────
     The signal comes to rest: the footer's top edge is the same line as the
     hero's wave, flat now, bright in the middle and gone at the ends. Under
     it, one quiet row (source/_data/footer.njk). */
  .footer {
    position: relative;
    margin-top: 40px;
    padding: 0;
    background: none;
    color: var(--mute);
  }

  .footer::before {
    content: "";
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    height: 1px;
    background: var(--signal-line);
  }

  .footer-inner {
    display: flex;
    width: auto;
    flex-direction: row;
    max-width: var(--page-w);
    box-sizing: border-box;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 20px;
    margin: 0 auto;
    padding: 36px var(--gutr) calc(36px + env(safe-area-inset-bottom, 0px)) var(--gut);
    font: 12px/1.8 var(--f-mono);
    text-align: left;
  }

  @media (max-width: 767px) {
    .footer-inner {
      padding-bottom: calc(88px + env(safe-area-inset-bottom, 0px));
    }
  }

  .footer-inner a {
    border-bottom: 1px solid var(--line-2);
    color: var(--mute);
    transition: color var(--t-fast) var(--ease);
  }

  .footer-inner a:hover {
    color: var(--fg);
  }

  .signal-coda {
    order: -1;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 20px;
    margin-right: auto;
  }

  .signal-coda-sign {
    color: var(--fg);
    font: italic 500 18px var(--f-poem);
  }

  .blog-runtime,
  .blog-visitors {
    font-family: var(--f-body);
    font-variant-numeric: tabular-nums;
  }

  .blog-runtime b,
  .blog-visitors b {
    color: var(--text);
    font-weight: 500;
  }

  .footer .with-love {
    display: none;
  }

  .footer .copyright,
  .footer .powered-by {
    margin: 0;
  }

  /* ───── NexT widgets ───── */
  .reading-progress-bar {
    top: calc(var(--header-h) + var(--header-top));
    z-index: 51;
    height: 2px;
    background: linear-gradient(90deg, var(--cyan), var(--violet));
  }

  .back-to-top,
  .sidebar-toggle {
    box-sizing: border-box;
    border: 1px solid var(--line-2);
    border-radius: 3px;
    background: rgba(12, 15, 25, .92);
    color: var(--mute);
    font: 12px var(--f-mono);
    opacity: 1;
  }

  .back-to-top:hover,
  .sidebar-toggle:hover {
    border-color: var(--cyan);
    color: var(--fg);
  }

  .sidebar-toggle .toggle-line {
    background: currentColor;
  }

  .back-to-top {
    width: auto;
    height: 34px;
    gap: 6px;
    padding: 0 10px;
  }

  .back-to-top span {
    margin-right: 0;
  }

  .back-to-top .fa {
    display: none;
  }

  .back-to-top::before {
    content: "\2191  TOP";
    letter-spacing: .08em;
    white-space: pre;
  }

  .sidebar-toggle {
    bottom: 72px;
    width: 34px;
    height: 34px;
    padding: 9px 8px;
  }

  /* ───── Sidebar: only the post's table of contents ───── */
  /* Pages without a TOC have nothing to open. */
  body:not(:has(.post-toc)) .sidebar-toggle,
  .sidebar:not(:has(.post-toc)) {
    display: none;
  }

  .sidebar {
    border-right: 1px solid var(--line);
    background: var(--ink);
    box-shadow: none;
    color: var(--mute);
  }

  .sidebar-inner {
    padding: calc(var(--header-h) + var(--header-top) + 24px) 20px 24px;
    color: var(--mute);
    text-align: left;
  }

  .sidebar-toc-title {
    margin: 0 0 12px;
    color: var(--mute);
    font: 11px var(--f-mono);
    letter-spacing: .2em;
    text-transform: uppercase;
  }

  /* Wide screens: a slim rail in the left margin, always shown, while the
     text stays centred. NexT would push the page right by 320px. */
  @media (min-width: 1200px) {
    .sidebar-active {
      padding-left: 0;
    }

    .sidebar,
    .sidebar-active .sidebar {
      --rail: min(220px, calc((100vw - var(--post-w)) / 2 - 72px));
      top: calc(var(--header-h) + var(--header-top) + 56px);
      bottom: auto;
      left: calc((100vw - var(--post-w)) / 2 - var(--rail) - 40px);
      width: var(--rail);
      max-height: calc(100vh - var(--header-h) - var(--header-top) - 170px);
      border: 0;
      background: none;
      transition: none;
    }

    .sidebar-inner {
      padding: 0;
    }

    .sidebar-toggle,
    .sidebar-dimmer {
      display: none;
    }
  }

  .sidebar a {
    border-bottom: 0;
    color: var(--mute);
  }

  .sidebar a:hover {
    color: var(--fg);
  }

  .post-toc .nav-item {
    line-height: 1.6;
  }

  .post-toc .nav .nav-child {
    padding-left: 12px;
  }

  /* NexT sizes an open sub-list for one line per item; in the narrow rail
     long titles wrap, so let it take its natural height. */
  .post-toc .nav .active > .nav-child {
    height: auto;
  }

  .post-toc .nav-item a {
    display: block;
    padding: 4px 0 4px 12px;
    border-left: 1px solid var(--line);
    color: var(--mute);
    font-size: 13px;
    text-align: left;
    transition: color var(--t-fast) var(--ease), border-color var(--t-fast) var(--ease);
  }

  .post-toc .nav-item a:hover,
  .post-toc .nav .active > a {
    border-left-color: var(--cyan);
    color: var(--fg);
  }

  .post-toc .nav .active-current > a {
    color: var(--cyan);
  }

  .post-toc .nav-number {
    font-family: var(--f-mono);
    font-size: 11px;
  }

  /* The floating buttons step aside while reading: they hide on the way
     down and come back on the way up or at the end of the page
     (signal.js sets .signal-chrome-hidden). */
  .back-to-top,
  .sidebar-toggle {
    transition: bottom var(--t-fast) var(--ease), transform var(--t-fast) var(--ease), opacity var(--t-fast) var(--ease);
  }

  @media (max-width: 1199px) {
    .signal-chrome-hidden .back-to-top,
    .signal-chrome-hidden body:not(.sidebar-active) .sidebar-toggle {
      opacity: 0;
      pointer-events: none;
      transform: translateY(16px);
    }

    .signal-chrome-hidden .back-to-top:focus-visible,
    .signal-chrome-hidden .sidebar-toggle:focus-visible {
      opacity: 1;
      pointer-events: auto;
      transform: none;
    }
  }

  /* On phones they move to the right edge, clear of where lines start. */
  @media (max-width: 767px) {
    .back-to-top,
    .sidebar-toggle {
      right: max(12px, env(safe-area-inset-right, 0px));
      left: auto;
      width: 40px;
      height: 40px;
      background: rgba(12, 15, 25, .72);
      -webkit-backdrop-filter: blur(6px);
      backdrop-filter: blur(6px);
    }

    .back-to-top {
      justify-content: center;
      padding: 0;
    }

    .back-to-top::before {
      content: "\2191";
      font-size: 16px;
      letter-spacing: 0;
    }

    .back-to-top.back-to-top-on {
      bottom: calc(16px + env(safe-area-inset-bottom, 0px));
    }

    .sidebar-toggle {
      display: flex;
      bottom: calc(60px + env(safe-area-inset-bottom, 0px));
      align-items: center;
      justify-content: center;
      padding: 0 12px;
      color: var(--fg);
    }

    .sidebar-toggle-icon {
      display: block;
      width: 20px;
    }

    /* NexT turns the lines into a cross with :first-child / :last-child,
       which also catch this wrapper once it is a block; keep it upright. */
    .sidebar-active .sidebar-toggle .sidebar-toggle-icon {
      top: 0;
      transform: none;
    }
  }

  .pagination {
    margin: 40px 0 0;
    padding: 0;
    border-top: 0;
    text-align: left;
  }

  .pagination .page-number,
  .pagination .prev,
  .pagination .next,
  .pagination .space {
    display: inline-block;
    min-width: 36px;
    margin: 0 6px 6px 0;
    padding: 6px 10px;
    border: 1px solid var(--line-2);
    border-radius: 2px;
    background: none;
    color: var(--mute);
    font: 12px var(--f-mono);
    text-align: center;
  }

  .pagination .page-number:hover,
  .pagination .prev:hover,
  .pagination .next:hover {
    border-color: var(--cyan);
    color: var(--fg);
  }

  .pagination .page-number.current {
    border-color: var(--fg);
    background: var(--fg);
    color: var(--void);
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
      transition-duration: .01ms !important;
      animation-duration: .01ms !important;
    }
  }

  /* Without JavaScript: a quiet note in the corner instead of NexT's red bar
     over the header (themes/next/source/css/noscript.styl). */
  html body {
    margin-top: 0;
  }

  body .noscript-warning {
    top: auto;
    right: auto;
    bottom: 12px;
    left: 12px;
    width: auto;
    max-width: calc(100vw - 24px);
    padding: 6px 10px;
    border: 1px solid var(--line-2);
    border-radius: 3px;
    background: rgba(12, 15, 25, .92);
    color: var(--mute);
    font: 12px/1.5 var(--f-mono);
    text-align: left;
  }

  /* Keyboard: the first Tab stop jumps past the header to the content. */
  .skip-link {
    position: fixed;
    top: 8px;
    left: 8px;
    z-index: 1000;
    padding: 8px 12px;
    border: 1px solid var(--cyan);
    border-radius: 3px;
    background: var(--ink);
    color: var(--fg);
    font: 13px var(--f-mono);
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
  }

  #main-content:focus {
    outline: 0;
  }

  /* Tag and category links are small text; give each a 24px tall target
     (WCAG 2.2 target size) without changing how they look. */
  .signal-seg-tags a,
  .post-meta-tags a,
  .post-tags a,
  .tag-cloud a,
  .signal-more,
  .footer .powered-by a {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
  }

  /* Page to page: the header holds still and the rest of the page
     dissolves into the next. A post's title flies from the link that was
     pressed to the top of the post, and back (head.njk). Only in browsers
     with cross-document view transitions; elsewhere pages change as before. */
  @view-transition {
    navigation: auto;
  }

  header.header {
    view-transition-name: signal-header;
  }

  ::view-transition-group(*) {
    animation-duration: .55s;
    animation-timing-function: var(--ease);
  }

  ::view-transition-old(root) {
    animation: .28s ease-in both signal-page-out;
  }

  ::view-transition-new(root) {
    animation: .42s .12s ease-out both signal-page-in;
  }

  ::view-transition-old(signal-header),
  ::view-transition-new(signal-header) {
    animation: none;
  }

  ::view-transition-old(signal-header) {
    display: none;
  }

  ::view-transition-group(signal-post-title) {
    animation-duration: .6s;
  }

  @keyframes signal-page-out {
    to { opacity: 0; transform: translateY(-6px); filter: blur(2px); }
  }

  @keyframes signal-page-in {
    from { opacity: 0; transform: translateY(10px); filter: blur(3px); }
  }

  @media (prefers-reduced-motion: reduce) {
    @view-transition {
      navigation: none;
    }
  }
}
