{
  "name": "hexo-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "prebuild": "npm run check:posts && hexo clean",
    "build": "hexo generate",
    "postbuild": "npm run check:site",
    "check:posts": "node scripts/check-posts.js",
    "check:site": "node tools/check-site.js",
    "clean": "hexo clean",
    "new:post": "hexo new post",
    "server": "hexo server",
    "server:drafts": "hexo server --draft",
    "test:checks": "node --test tools/check-site.test.js"
  },
  "hexo": {
    "version": "8.1.2"
  },
  "dependencies": {
    "hexo": "^8.0.0",
    "hexo-front-matter": "^5.0.0",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-feed": "^4.0.0",
    "hexo-generator-index": "^4.0.0",
    "hexo-generator-searchdb": "^1.5.0",
    "hexo-generator-sitemap": "^3.0.1",
    "hexo-generator-tag": "^2.0.0",
    "hexo-renderer-marked": "^7.0.0",
    "hexo-renderer-stylus": "^3.0.1",
    "hexo-server": "^3.0.0"
  },
  "overrides": {
    "stylus": "0.64.0",
    "glob": "13.0.6",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "parse5": "7.3.0"
  }
}
